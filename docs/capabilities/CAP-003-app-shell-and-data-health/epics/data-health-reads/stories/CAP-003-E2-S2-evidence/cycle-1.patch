+    assert _items(problems=NONE_PROBLEMS) == ()
+    assert _items(problems=Problems(1, ("AAA",), T1)) == (AttentionItem("data_problems", T1, None),)
+    # The rule is the count, not the timestamp (DAC-E2-8).
+    assert _items(problems=Problems(0, (), T1)) == ()
