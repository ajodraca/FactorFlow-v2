+++ b/tests/unit/test_outcomes.py
@@ -17,7 +17,9 @@ import pytest
 from factorflow.ingestion.massive.errors import (
     CredentialRejected,
     InstrumentNotFound,
+    MassiveError,
     ProviderContractViolation,
