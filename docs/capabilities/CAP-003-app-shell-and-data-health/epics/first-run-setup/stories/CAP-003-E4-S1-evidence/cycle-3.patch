+
+/** Each step card's question; step 4's is `STEP4.downloadFor` (setup-ui 10). */
+export const QUESTIONS = {
+  1: "Connect market data",
+  2: "How far back should history go?",
+  3: "Which stocks do you want to follow?",
+};
