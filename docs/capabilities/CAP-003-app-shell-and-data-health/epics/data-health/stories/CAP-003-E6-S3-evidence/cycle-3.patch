+    await act(async () => {
+      stale.resolve({ runs: [RUN()], nextCursor: null });
+    });
+    expect(screen.getByText("No complete download yet")).toBeInTheDocument();
+    expect(screen.queryByText(/Last complete download/)).toBeNull();
+  });
+});
