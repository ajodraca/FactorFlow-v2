+    gap_stock_count: null,
+    behind_count: 1,
+    gap_detection: { available: false, reason: NO_GAPS_REASON },
+    exception_count: 7,
+    exception_symbols: ["AAA", "BBB", "CCC", "DDD", "EEE"],
+  };
+
+  function everyState(): HTMLElement[] {
+    const roots: HTMLElement[] = [];
+    for (const check of [
