+    for (const id of (element.getAttribute("aria-describedby") ?? "").split(" ")) {
+      const text = id ? container.querySelector(`[id="${CSS.escape(id)}"]`)?.textContent : null;
+      if (text) parts.push(text);
+    }
+  }
+  return parts.join(" ");
