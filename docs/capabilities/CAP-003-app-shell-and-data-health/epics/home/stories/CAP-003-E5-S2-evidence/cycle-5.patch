+
+// Review v1 rework (CAP-003-E5-S2-implementation-review-v1, IR-001 to IR-007).
+const NEVER_BUILDING = SUMMARY({
+  never_classified: true,
+  set: null,
+  stocks_current: null,
+  later: BUILDING.later,
+});
+const BIG = SUMMARY({ stocks_current: { current_count: 1233, followed_count: 1236 } });
+const classesOf = (el: Element | null | undefined): string[] => [...(el?.classList ?? [])];
+
+describe("DataTile review v1 rework", () => {
+  it("IR-001: a building later set alone, with no set, shows the lag badge", () => {
+    const c = show(ok(ATTENTION), served(NEVER_BUILDING));
+    expect(variantOf(lagOf(c))).toBe("status-warning");
+    expect(lagOf(c)?.textContent?.trim()).toBe("Not reflecting the latest download");
+  });
+
+  it("IR-002: the hero and the name group thousands when served", () => {
+    const c = show(ok({ ...ATTENTION, followed_count: 1236 }), served(BIG));
+    expect(collapsed(heroOf(c))).toBe("1,233 of 1,236 stocks current");
+    expect(nameOf(c)).toContain("1,233 of 1,236 stocks current");
+  });
+
+  it("IR-002: the followed count groups thousands when not served", () => {
+    const c = show(ok({ ...ATTENTION, followed_count: 1236 }), NOT_SERVED);
+    expect(collapsed(heroOf(c))).toBe("—not determinable of 1,236 stocks current");
+    expect(nameOf(c)).toContain("not determinable of 1,236 stocks current");
+  });
+
+  it.each([
+    ["attention fails", ATT_UNREACHABLE, NOT_SERVED],
+    ["the summary fails", ok(ATTENTION), SUMMARY_500],
+  ])("IR-003: when %s the error card is a metric card and a region named Data", (_n, a, s) => {
+    const c = show(a, s);
+    expect(within(c).getByRole("region", { name: "Data" })).toBeTruthy();
+    expect(c.querySelector('[data-variant="metric"]')).not.toBeNull();
+  });
+
+  it.each([
+    ["attention loading", ATT_LOADING, NOT_SERVED],
+    ["summary loading", ok(ATTENTION), LOADING],
+  ])("IR-004: the %s skeleton is a titled region over a pulse block", (_n, a, s) => {
+    const c = show(a, s);
+    const card = c.querySelector('[data-testid="data-tile-skeleton"]');
+    expect(card?.getAttribute("data-variant")).toBe("metric");
+    expect(within(c).getByRole("heading", { level: 2, name: "Data" })).toBeTruthy();
+    expect(within(c).getByRole("region", { name: "Data" })).toBeTruthy();
+    const pulse = card?.querySelector('[aria-hidden="true"]');
+    for (const name of ["min-h-7", "w-full", "animate-pulse", "rounded", "bg-secondary"]) {
+      expect(classesOf(pulse)).toContain(name);
+    }
+  });
+
+  it("IR-005: the link is a block with rounded corners and the scope sentence is muted small text", () => {
+    const c = show(ok(ATTENTION), served(SUMMARY()));
+    const link = within(c).getByRole("link");
+    expect(classesOf(link)).toContain("block");
+    expect(classesOf(link)).toContain("rounded");
+    const scope = lineStarting(c, "Every other number");
+    expect(classesOf(scope)).toContain("text-xs");
+    expect(classesOf(scope)).toContain("text-muted-foreground");
+  });
+
+  it("IR-006: Downloading sits under the title, before the first-download sentence", () => {
+    const c = show(ok(FIRST("running", "2026-10-15T21:02:00Z")), NOT_SERVED);
+    const heading = within(c).getByRole("heading", { level: 2, name: "Data" });
+    const badge = c.querySelector('[data-testid="data-tile-badge"]') as Element;
+    const sentence = within(c).getByText(/Your first download, started/);
+    expect(heading.compareDocumentPosition(badge) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+    expect(badge.compareDocumentPosition(sentence) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+  });
+});
