+import { render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import type { ReactElement } from "react";
+import { MemoryRouter, Route, Routes, useLocation } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ApiError, ApiUnreachableError } from "../../api/client";
+import type { ShellContextValue } from "../../app/shell-context";
+import type { Attention, ReadState, ScoreState, ScoreSummary } from "../../app/shell-types";
+import HomeScreen from "./index";
+import { NEEDS_YOU_STATES } from "./needs-you-card";
+
+// The Home screen (CAP-003-E5-S3; component design home-ui 2.1, 2.2, section 3
+// and section 10; UX design 1.3). Every expected string is a literal; fixtures
+// are independent literals typed `Attention` and `ScoreSummary`.
+
+const shell = vi.hoisted(() => ({ value: {} as unknown as ShellContextValue }));
+vi.mock("../../app/shell-context", () => ({ useShell: () => shell.value }));
+
+const ATTENTION: Attention = {
+  checked_at: "2026-10-15T22:52:10Z",
+  followed_count: 26,
+  prices_as_of: "2026-10-14",
+  credential_present: false,
+  problems: {
+    stock_count: 3,
+    symbols: ["KO", "TSLA", "FBXX"],
+    newest_completed_at: "2026-10-15T22:31:00Z",
+  },
+  latest_download: {
+    run_id: "run-7",
+    state: "failed",
+    requested_at: "2026-10-15T21:00:00Z",
+    started_at: "2026-10-15T21:02:00Z",
+    ended_at: "2026-10-15T22:40:00Z",
+    progress: { done: 30, total: 30 },
+  },
+  latest_terminal_download: {
+    run_id: "run-7",
+    state: "failed",
+    ended_at: "2026-10-15T22:40:00Z",
+    failure_reason: "The market data service refused the request",
+  },
+  items: [
+    { kind: "data_problems", recorded_at: "2026-10-15T22:31:00Z", run_id: null },
+    { kind: "download_not_complete", recorded_at: "2026-10-15T22:40:00Z", run_id: "run-7" },
+    { kind: "credential_missing", recorded_at: "2026-10-15T22:52:10Z", run_id: null },
+  ],
+};
+
+const INTERRUPTED: Attention = {
+  ...ATTENTION,
+  latest_download: {
+    ...ATTENTION.latest_download,
+    state: "abandoned",
+  } as Attention["latest_download"],
+  latest_terminal_download: {
+    run_id: "run-7",
+    state: "abandoned",
+    ended_at: "2026-10-15T22:40:00Z",
+    failure_reason: null,
+  },
+};
+
+function FIRST(total: number | null): Attention {
+  return {
+    ...ATTENTION,
+    credential_present: true,
+    problems: { stock_count: 0, symbols: [], newest_completed_at: null },
+    items: [],
+    latest_terminal_download: null,
+    latest_download: {
+      run_id: "run-1",
+      state: "running",
+      requested_at: "2026-10-15T21:00:00Z",
+      started_at: "2026-10-15T21:02:00Z",
+      ended_at: null,
+      progress: { done: 12, total },
+    },
+  };
+}
+
+const NEVER_DOWNLOADED: Attention = { ...FIRST(30), latest_download: null };
+
+const SCORED: Attention = {
+  ...FIRST(30),
+  latest_download: {
+    ...FIRST(30).latest_download,
+    state: "succeeded",
+    ended_at: "2026-10-15T22:40:00Z",
+  } as Attention["latest_download"],
+  latest_terminal_download: {
+    run_id: "run-1",
+    state: "succeeded",
+    ended_at: "2026-10-15T22:40:00Z",
+    failure_reason: null,
+  },
+};
+
+const FACTOR = { qualified_count: 30, ranked: true, min_peer_set_size: 5 };
+
+function SUMMARY(over: Partial<ScoreSummary> = {}): ScoreSummary {
+  return {
+    never_classified: false,
+    set: {
+      set_id: "s-1",
+      classification_date: "2026-10-15",
+      run_id: "run-1",
+      run_started_at: "2026-10-15T21:02:00Z",
+      run_outcome: "succeeded",
+      state: "complete",
+      started_at: "2026-10-15T22:41:00Z",
+      ended_at: "2026-10-15T22:46:00Z",
+      latest_trading_day: "2026-10-15",
+      active_instruments: 30,
+      not_current: false,
+    },
+    later: null,
+    factors: Object.fromEntries(
+      (["value", "quality", "momentum"] as const).map((name) => [name, FACTOR]),
+    ) as ScoreSummary["factors"],
+    stocks_current: { current_count: 27, followed_count: 30 },
+    ...over,
+  } as ScoreSummary;
+}
+
+const FAILED = SUMMARY({
+  set: { ...SUMMARY().set, not_current: true } as ScoreSummary["set"],
+  later: {
+    set_id: "s-2",
+    state: "failed",
+    started_at: "2026-10-15T23:00:00Z",
+    ended_at: "2026-10-15T23:05:00Z",
+    failure_reason: "The scoring engine stopped",
+    run_id: "run-8",
+    run_started_at: "2026-10-15T22:58:00Z",
+  },
+});
+const NEVER_BUILDING = SUMMARY({
+  never_classified: true,
+  set: null,
+  stocks_current: null,
+  later: {
+    set_id: "s-1",
+    state: "building",
+    started_at: "2026-10-15T22:41:00Z",
+    ended_at: null,
+    failure_reason: null,
+    run_id: "run-1",
+    run_started_at: "2026-10-15T21:02:00Z",
+  },
+});
+const NEVER_FAILED = SUMMARY({
+  never_classified: true,
+  set: null,
+  stocks_current: null,
+  later: {
+    set_id: "s-1",
+    state: "failed",
+    started_at: "2026-10-15T22:41:00Z",
+    ended_at: "2026-10-15T23:05:00Z",
+    failure_reason: "The scoring engine stopped",
+    run_id: "run-1",
+    run_started_at: "2026-10-15T21:02:00Z",
+  },
+});
+
+const served = (data: ScoreSummary): ScoreState => ({
+  kind: "served",
+  data,
+  checkedAt: new Date("2026-10-15T22:53:00Z"),
+});
+const NOT_SERVED: ScoreState = { kind: "not_served" };
+const SCORES_LOADING: ScoreState = { kind: "loading" };
+const SUMMARY_500: ScoreState = {
+  kind: "error",
+  error: new ApiError("Internal error", "req-9f3", { code: "internal_error" }),
+  last: null,
+};
+const ok = (data: Attention): ReadState<Attention> => ({
+  kind: "ok",
+  data,
+  checkedAt: new Date("2026-10-15T22:53:41Z"),
+});
+const ATT_LOADING: ReadState<Attention> = { kind: "loading" };
+const ATT_UNREACHABLE: ReadState<Attention> = {
+  kind: "error",
+  error: new ApiUnreachableError("GET /api/attention could not be reached"),
+  last: {
+    data: { ...ATTENTION, checked_at: "2026-10-15T22:40:05Z" },
+    checkedAt: new Date("2026-10-15T22:40:06Z"),
+  },
+};
+const ATT_500: ReadState<Attention> = {
+  kind: "error",
+  error: new ApiError("Internal error", "req-9f3", { code: "internal_error" }),
+  last: null,
+};
+
+const ZERO_ITEMS: Attention = {
+  ...FIRST(30),
+  latest_download: {
+    ...FIRST(30).latest_download,
+    state: "succeeded",
+  } as Attention["latest_download"],
+  latest_terminal_download: {
+    run_id: "run-1",
+    state: "succeeded",
+    ended_at: "2026-10-15T22:40:00Z",
+    failure_reason: null,
+  },
+};
+
+function LocationProbe(): ReactElement {
+  return <p data-testid="location">{useLocation().pathname}</p>;
+}
+
+function show(attention: ReadState<Attention>, scores: ScoreState) {
+  shell.value = {
+    health: { kind: "loading" },
+    attention,
+    scores,
+    refresh: vi.fn(),
+    setTitleDetail: vi.fn(),
+  } as unknown as ShellContextValue;
+  return render(
+    <MemoryRouter initialEntries={["/home"]}>
+      <Routes>
+        <Route path="/home" element={<HomeScreen />} />
+        <Route path="*" element={<LocationProbe />} />
+      </Routes>
+    </MemoryRouter>,
+  );
+}
+
+const card = (): HTMLElement => screen.getByRole("region", { name: /^Needs you/ });
+const squash = (e: Element | null): string => (e?.textContent ?? "").replace(/\s+/g, " ").trim();
+const titlesOf = (): string[] =>
+  within(card())
+    .queryAllByRole("listitem")
+    .map((row) => squash(row.querySelector("p.font-semibold")));
+
+beforeEach(() => {
+  vi.useFakeTimers({ shouldAdvanceTime: true });
+  vi.setSystemTime(new Date("2026-10-16T01:00:00Z"));
+});
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+const userSetup = () => userEvent.setup({ advanceTimers: vi.advanceTimersByTime });
+
+/** Every state this story renders, for the whole-screen scans (T006, T009). */
+function ALL_STATES(): [ReadState<Attention>, ScoreState][] {
+  return [
+    [ATT_LOADING, SCORES_LOADING],
+    [ATT_UNREACHABLE, served(SUMMARY())],
+    [ATT_500, served(SUMMARY())],
+    [ok(NEVER_DOWNLOADED), NOT_SERVED],
+    [ok(ATTENTION), served(SUMMARY())],
+    [ok(ATTENTION), SUMMARY_500],
+    [ok(INTERRUPTED), served(SUMMARY())],
+    [ok(ZERO_ITEMS), served(SUMMARY())],
+    [ok(FIRST(30)), NOT_SERVED],
+    [ok(FIRST(null)), NOT_SERVED],
+    [ok(SCORED), served(NEVER_BUILDING)],
+    [ok(SCORED), served(FAILED)],
+    [ok(SCORED), served(NEVER_FAILED)],
+    [
+      ok({
+        ...ATTENTION,
+        latest_terminal_download: {
+          ...ATTENTION.latest_terminal_download,
+          failure_reason: null,
+        } as Attention["latest_terminal_download"],
+      }),
+      served(SUMMARY()),
+    ],
+    [
+      ok({
+        ...ATTENTION,
+        items: [ATTENTION.items[0]] as Attention["items"],
+        problems: { stock_count: 1, symbols: ["KO"], newest_completed_at: "2026-10-15T22:31:00Z" },
+      }),
+      served(SUMMARY()),
+    ],
+    [
+      ok({
+        ...ATTENTION,
+        items: [ATTENTION.items[0]] as Attention["items"],
+        problems: {
+          stock_count: 1239,
+          symbols: ["FBXX", "KO", "TSLA"],
+          newest_completed_at: "2026-10-15T22:31:00Z",
+        },
+      }),
+      served(SUMMARY()),
+    ],
+  ];
+}
+
+describe("empty state before any download (TC-COMP-127; DAC-E5-1, AC-21)", () => {
+  // Implements TC-COMP-127
+  it("states that nothing has been downloaded and offers setup", async () => {
+    const user = userSetup();
+    show(ok(NEVER_DOWNLOADED), NOT_SERVED);
+    expect(screen.getByRole("heading", { level: 1 }).textContent).toBe("Thursday, 2026-10-15");
+    const region = screen.getByRole("region", { name: "No data has been downloaded yet." });
+    expect(region.tagName).toBe("SECTION");
+    expect(region.querySelector("h2")?.textContent).toBe("No data has been downloaded yet.");
+    expect((region.firstElementChild as HTMLElement).getAttribute("data-variant")).toBe("default");
+    expect(squash(region)).toContain(
+      "Set up FactorFlow to name the stocks to follow and start the first download.",
+    );
+    const links = within(region).getAllByRole("link");
+    expect(links).toHaveLength(1);
+    const setup = links[0] as HTMLElement;
+    expect(setup.textContent).toBe("Start setup");
+    expect(setup.getAttribute("href")).toBe("/setup");
+    expect(setup.getAttribute("data-variant")).toBe("default");
+
+    expect(screen.queryByRole("region", { name: "Data" })).toBeNull();
+    expect(screen.queryByRole("region", { name: /^Needs you/ })).toBeNull();
+    expect(screen.queryByTestId("home-summary-row")).toBeNull();
+    expect(screen.queryAllByRole("listitem")).toEqual([]);
+    expect(screen.queryAllByRole("link", { name: /^Data:/ })).toEqual([]);
+
+    for (let guard = 0; guard < 10 && document.activeElement !== setup; guard += 1) {
+      await user.tab();
+    }
+    await user.keyboard("{Enter}");
+    expect(screen.getByTestId("location").textContent).toBe("/setup");
+  });
+
+  it("keys on latest_download, so a running first download is not the empty state", () => {
+    show(ok(FIRST(30)), NOT_SERVED);
+    expect(screen.queryByRole("region", { name: "No data has been downloaded yet." })).toBeNull();
+    expect(screen.getByTestId("home-summary-row")).not.toBeNull();
+  });
+});
+
+describe("no strategy, paper or live element (TC-COMP-130; DAC-E5-10, AC-10)", () => {
+  // Implements TC-COMP-130
+  const UNSHIPPED = /\b(?:strateg(?:y|ies)|paper|live|rebalance)\b/i;
+
+  it("scans every state's text and attributes", () => {
+    for (const [attention, scores] of ALL_STATES()) {
+      const { container, unmount } = show(attention, scores);
+      const seen = [container.textContent ?? ""];
+      for (const element of container.querySelectorAll("*")) {
+        for (const name of ["aria-label", "title", "alt", "role", "data-testid"]) {
+          const value = element.getAttribute(name);
+          if (value !== null) {
+            seen.push(value);
+          }
+        }
+      }
+      for (const value of seen) {
+        expect(value).not.toMatch(UNSHIPPED);
+      }
+      unmount();
+    }
+  });
+
+  it("has a scanner that catches what it should", () => {
+    for (const hit of [
+      "Your strategies",
+      "+ New strategy",
+      "Paper",
+      "Live tile",
+      "next rebalance",
+    ]) {
+      expect(hit).toMatch(UNSHIPPED);
+    }
+    for (const miss of ["delivered", "olive"]) {
+      expect(miss).not.toMatch(UNSHIPPED);
+    }
+  });
+
+  it("leaves columns two and three of the summary row empty", () => {
+    const { container } = show(ok(ATTENTION), served(SUMMARY()));
+    const row = screen.getByTestId("home-summary-row");
+    expect(row.className).toContain("grid-cols-3");
+    expect(row.children).toHaveLength(1);
+    expect((row.children[0] as HTMLElement).getAttribute("aria-labelledby")).not.toBeNull();
+    expect(within(row).getByRole("region", { name: "Data" })).toBe(row.children[0]);
+    expect(row.contains(card())).toBe(false);
+    const header = container.querySelector("header") as HTMLElement;
+    expect(within(header).queryAllByRole("link")).toEqual([]);
+    expect(within(header).queryAllByRole("button")).toEqual([]);
+  });
+});
+
+describe("attention failure on Home (TC-COMP-131 Home half; DAC-E5-11)", () => {
+  // Implements TC-COMP-131 (Home half; CAP-003-E5-S2 asserts the tile half)
+  it("keeps the header, shows both cards' errors, and retries from the card", async () => {
+    const user = userSetup();
+    show(ATT_UNREACHABLE, served(SUMMARY()));
+    expect(screen.getByRole("heading", { level: 1 }).textContent).toBe("Thursday, 2026-10-15");
+    expect(squash(screen.getByTestId("as-of-line"))).toContain("checked 17:40:05 CDT");
+    expect(squash(card())).toContain("Couldn't read what needs you: FactorFlow is not answering.");
+    expect(within(card()).queryAllByRole("listitem")).toEqual([]);
+    expect(squash(card())).toContain("checked 17:40:05 CDT");
+    expect(squash(card())).not.toContain("17:52:10");
+    expect(squash(card())).not.toContain("20:00");
+    const heading = within(card()).getByRole("heading", {
+      level: 2,
+      name: "Needs you · not determinable",
+    });
+    expect(heading.querySelector('[aria-hidden="true"]')?.textContent).toBe("—");
+    expect(heading.querySelector(".sr-only")?.textContent).toBe("not determinable");
+    expect(squash(screen.getByRole("region", { name: "Data" }))).toContain(
+      "Couldn't read the data summary: FactorFlow is not answering.",
+    );
+    expect(screen.getAllByRole("button", { name: "Try again" })).toHaveLength(2);
+    await user.click(within(card()).getByRole("button", { name: "Try again" }));
+    expect(shell.value.refresh).toHaveBeenCalledTimes(1);
+    expect(shell.value.refresh).toHaveBeenCalledWith("attention");
+  });
+
+  it("says an unexpected problem without the server's words", () => {
+    show(ATT_500, served(SUMMARY()));
+    expect(squash(card())).toContain(
+      "Couldn't read what needs you: FactorFlow hit an unexpected problem.",
+    );
+    expect(document.body.textContent).not.toContain("req-9f3");
+    expect(document.body.textContent).not.toContain("Internal error");
+    const checked = [...card().querySelectorAll("p")].find((p) => squash(p).startsWith("checked"));
+    expect(squash(checked ?? null)).toBe("checked —not determinable");
+    expect(checked?.querySelector('[aria-hidden="true"]')?.textContent).toBe("—");
+  });
+
+  it("keeps the three server items when the summary fails with 500, and the tile shows its error", () => {
+    show(ok(ATTENTION), SUMMARY_500);
+    expect(titlesOf()).toEqual([
+      "The market data key is missing",
+      "The last download failed",
+      "KO, TSLA and FBXX are missing data",
+    ]);
+    expect(squash(card())).not.toContain("Couldn't read what needs you");
+    expect(squash(screen.getByRole("region", { name: "Data" }))).toContain(
+      "Couldn't read the data summary: FactorFlow hit an unexpected problem.",
+    );
+  });
+
+  it("keeps server items and the first-download item under a summary 404", () => {
+    show(
+      ok({
+        ...FIRST(30),
+        credential_present: false,
+        problems: ATTENTION.problems,
+        items: [ATTENTION.items[0], ATTENTION.items[2]] as Attention["items"],
+      }),
+      NOT_SERVED,
+    );
+    expect(titlesOf()).toEqual([
+      "The market data key is missing",
+      "KO, TSLA and FBXX are missing data",
+      "Your first download is running",
+    ]);
+    const last = within(card()).queryAllByRole("listitem").at(-1) as HTMLElement;
+    expect(squash(last.querySelectorAll("p")[1] ?? null)).toBe(
+      "12 of 30 stocks so far. Scores appear when it finishes.",
+    );
+  });
+});
+
+describe("the eight states (TC-COMP-143; DAC-E5-S3-3, AC-24)", () => {
+  // Implements TC-COMP-143
+  it("loading", () => {
+    show(ATT_LOADING, SCORES_LOADING);
+    expect(screen.getByRole("heading", { level: 1 })).not.toBeNull();
+    expect(screen.getByTestId("home-as-of-skeleton")).not.toBeNull();
+    expect(screen.getByTestId("data-tile-skeleton")).not.toBeNull();
+    const skeleton = screen.getByTestId("needs-you-skeleton");
+    expect(skeleton.children).toHaveLength(3);
+    expect(skeleton.closest('[aria-busy="true"]')).not.toBeNull();
+    expect(card().querySelector("h2")?.textContent).toBe("Needs you");
+    expect(document.body.textContent).not.toContain("Couldn't read");
+  });
+
+  it("empty, never populated", () => {
+    show(ok(NEVER_DOWNLOADED), NOT_SERVED);
+    expect(screen.getByRole("region", { name: "No data has been downloaded yet." })).not.toBeNull();
+  });
+
+  it("populated, with items and with none", () => {
+    const first = show(ok(ATTENTION), served(SUMMARY()));
+    expect(titlesOf()).toHaveLength(3);
+    expect(card().querySelector('[aria-busy="true"]')).toBeNull();
+    first.unmount();
+    show(ok(ZERO_ITEMS), served(SUMMARY()));
+    expect(squash(card())).toContain("Nothing needs you right now.");
+    expect(card().querySelector('[aria-busy="true"]')).toBeNull();
+  });
+
+  it("stale: the aging checked time", () => {
+    show(ATT_UNREACHABLE, served(SUMMARY()));
+    expect(squash(card())).toContain("checked 17:40:05 CDT");
+    expect(squash(screen.getByTestId("as-of-line"))).toContain("checked 17:40:05 CDT");
+  });
+
+  it("unavailable: the server items stay and the tile's figures are not determinable", () => {
+    show(ok(ATTENTION), NOT_SERVED);
+    expect(titlesOf()).toHaveLength(3);
+    const tile = screen.getByRole("region", { name: "Data" });
+    expect(squash(tile)).toContain("not determinable");
+    const absent = tile.querySelector(".text-value-missing");
+    expect(absent?.querySelector('[aria-hidden="true"]')?.textContent).toBe("—");
+    expect(absent?.querySelector(".sr-only")?.textContent).toBe("not determinable");
+  });
+
+  it("records the kinds that do not apply, and renders the three that do", () => {
+    const records = Object.entries(NEEDS_YOU_STATES).filter(([, v]) => typeof v !== "function");
+    expect(records.map(([k]) => k).sort()).toEqual([
+      "empty-never-populated",
+      "empty-no-match",
+      "partial",
+      "unavailable",
+      "unreachable",
+    ]);
+    for (const [, record] of records) {
+      expect((record as { notApplicable: string }).notApplicable.length).toBeGreaterThan(20);
+    }
+    for (const kind of ["loading", "populated", "error"] as const) {
+      expect(typeof NEEDS_YOU_STATES[kind]).toBe("function");
+    }
+  });
+
+  it("does not render unreachable: attention never takes that kind and the shell replaces the main region", () => {
+    expect(NEEDS_YOU_STATES.unreachable).toEqual({ notApplicable: expect.any(String) });
+    show(ATT_UNREACHABLE, served(SUMMARY()));
+    expect(card()).not.toBeNull();
+  });
+});
+
+describe("display vocabulary (TC-COMP-145; DAC-E5-S3-5, AC-19)", () => {
+  // Implements TC-COMP-145
+  const TERMS =
+    /\b(?:instrument|acquisition|acquire|run|runs|retire|retired|provider credential)\b/i;
+
+  it("has a scanner that catches what it should", () => {
+    for (const hit of ["Next run", "RUNS", "Provider Credential", "instrument", "Retired"]) {
+      expect(hit).toMatch(TERMS);
+    }
+    for (const miss of ["running", "Downloads", "rerun"]) {
+      expect(miss).not.toMatch(TERMS);
+    }
+  });
+
+  it("uses none of the eight terms in any state, text or accessible name", () => {
+    for (const [attention, scores] of ALL_STATES()) {
+      const { container, unmount } = show(attention, scores);
+      const seen = [container.textContent ?? ""];
+      for (const element of container.querySelectorAll("[aria-label], [title], [alt]")) {
+        for (const name of ["aria-label", "title", "alt"]) {
+          const value = element.getAttribute(name);
+          if (value !== null) {
+            seen.push(value);
+          }
+        }
+      }
+      for (const value of seen) {
+        expect(value).not.toMatch(TERMS);
+      }
+      unmount();
+    }
+  });
+});
+
+describe("composition and layout (AC-10, AC-25, AC-26, DAC-E5-10)", () => {
+  it("renders inside the shell's main, capped, in the stated order", () => {
+    const { container } = show(ok(ATTENTION), served(SUMMARY()));
+    expect(container.querySelector("main")).toBeNull();
+    expect(screen.getAllByRole("heading", { level: 1 })).toHaveLength(1);
+    const root = container.firstElementChild as HTMLElement;
+    expect(root.style.maxWidth).toBe("1180px");
+    for (const name of ["w-full", "flex", "flex-col", "gap-5"]) {
+      expect(root.className).toContain(name);
+    }
+    const children = [...root.children];
+    expect(children).toHaveLength(3);
+    expect((children[0] as HTMLElement).tagName).toBe("HEADER");
+    expect(children[1]).toBe(screen.getByTestId("home-summary-row"));
+    expect(children[2]).toBe(card());
+    expect(screen.getByTestId("home-summary-row").className).toContain("gap-5");
+  });
+
+  it("shows the first-download sentence in the tile and the item in the card", () => {
+    show(ok(FIRST(30)), NOT_SERVED);
+    expect(squash(screen.getByRole("region", { name: "Data" }))).toContain(
+      "Your first download, started 2026-10-15 16:02 CDT, is running.",
+    );
+    expect(titlesOf()).toEqual(["Your first download is running"]);
+  });
+
+  it("reaches every link by tab in document order, with no tabindex", async () => {
+    const user = userSetup();
+    const { container } = show(ok(ATTENTION), served(SUMMARY()));
+    const expected = [
+      screen.getByRole("link", { name: /^Data:/ }),
+      ...within(card()).getAllByRole("link"),
+    ];
+    expect([...container.querySelectorAll("a[href], button")]).toEqual(expected);
+    for (const link of expected) {
+      await user.tab();
+      expect(document.activeElement).toBe(link);
+    }
+    for (const element of container.querySelectorAll("[tabindex]")) {
+      const value = Number(element.getAttribute("tabindex"));
+      expect(value).toBe(0);
+    }
+  });
+});
