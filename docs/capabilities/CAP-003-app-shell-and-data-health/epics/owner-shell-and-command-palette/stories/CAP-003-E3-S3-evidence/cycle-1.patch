+  const queue = queues.get(path) ?? [];
+  queue.push(promise);
+  queues.set(path, queue);
+  return { resolve: (status, body) => settle({ status, body }) };
+}
+
+function calls(path: string): number {
+  return counts.get(path) ?? 0;
+}
