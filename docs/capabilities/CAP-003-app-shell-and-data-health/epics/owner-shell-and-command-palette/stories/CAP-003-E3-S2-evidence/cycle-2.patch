+    expect(read).toHaveBeenCalledTimes(3);
+  });
+
+  it("uses a changed read and intervalMs from the next read on, without restarting the poll", async () => {
+    const firstRead = vi.fn<() => Promise<Answer>>().mockResolvedValue({ fast: false });
