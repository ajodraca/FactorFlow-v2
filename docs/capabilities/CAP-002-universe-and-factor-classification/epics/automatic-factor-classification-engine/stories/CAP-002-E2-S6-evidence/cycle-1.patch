diff --git a/tests/integration/engine_restatement_support.py b/tests/integration/engine_restatement_support.py
new file mode 100644
index 0000000..6bafc2e
--- /dev/null
+++ b/tests/integration/engine_restatement_support.py
@@ -0,0 +1,229 @@
+"""Helpers for the restatement-mark tests (CAP-002-E2-S6).
+
+A plain module rather than ``conftest.py``. It imports the helper modules of CAP-002-E2-S2,
+CAP-002-E2-S3 and CAP-002-E2-S5 and edits none of them (T002). Every statement row is
+written through S3's ``add_statement`` with ``observed_on`` and ``provider_filing_date``
+passed explicitly, so the instrument's first fundamentals ``observed_on``, which
+``statements.sql`` compares the filing date with (DEC-0056), is the one a test intends.
+Every writing helper commits, and every reading helper ends its transaction.
+"""
+
+from collections.abc import Collection
+from datetime import date, timedelta
+from decimal import Decimal
+from typing import Any
+from uuid import UUID
+
+import psycopg
+import pytest
+
+from factorflow.classification import constants, engine, line_items
+from factorflow.classification.engine import BuildResult
+from tests.integration.engine_inputs_support import (
+    TEST_KEYS,
+    add_statement,
+    install_test_line_items,
+    months_before,
+)
+from tests.integration.engine_support import add_bar
+
+MIN_FLOOR = 3
+"""The peer-set floor the tests build at, so four hand-built stocks rank; S5 tests the 30."""
+
+STATEMENT_TYPES = ("balance_sheet", "income_statement", "cash_flow_statement")
+BACKFILL_LEAD = timedelta(days=30)
+"""How long before the first observation a backfilled row was filed."""
+
+_INSERT_INPUT = (
+    "INSERT INTO factor_input (set_id, instrument_id, factor, input_name, status, value, "
+    "as_of, known_on, restated_possible, detail) "
+    "VALUES (%s, %s, %s, %s, 'present', %s, %s, %s, %s, '{}'::jsonb)"
+)
+_INPUT_DATE = date(2026, 10, 2)
+
+
+def all_rows(quarters: int = 8) -> frozenset[tuple[str, int]]:
+    """Every ``(statement_type, quarter_index)`` ``add_fundamentals`` writes."""
+    return frozenset((t, k) for t in STATEMENT_TYPES for k in range(quarters))
+
+
+def run_two_stage_build(
+    conn: psycopg.Connection,
+    set_id: UUID,
+    monkeypatch: pytest.MonkeyPatch,
+    floor: int = MIN_FLOOR,
+) -> BuildResult:
+    """``engine.build`` with the fundamentals and classification stages only, at ``floor``.
+
+    Neither CAP-002-E2-S4's momentum stage nor any later story's stage runs.
+    """
+    monkeypatch.setattr(constants, "MIN_PEER_SET_SIZE", floor)
+    install_test_line_items(monkeypatch)
+    monkeypatch.setattr(
+        engine, "_STAGES", [engine._fundamental_inputs_stage, engine._classification_stage]
+    )
+    return engine.build(conn, set_id, 60)
+
+
+def statement_payload(
+    instrument_id: int, statement_type: str, quarter_index: int
+) -> dict[str, Decimal]:
+    """The statement's payload under the test keys, distinct per stock and quarter.
+
+    The per-stock terms are not linear in one another, so no two inputs are perfectly
+    correlated across a peer set, and every prior-year sum stays positive.
+    """
+    s, k = instrument_id, quarter_index
+    items: dict[str, Decimal] = {
+        "book_equity": Decimal(400 + 37 * s - 10 * k),
+        "shares_outstanding": Decimal(100 + 10 * (s * s % 7) + s),
+        "net_income": Decimal(12 + 5 * s % 9 - k),
+        "diluted_eps": Decimal(18 + 3 * (s % 4) - k) / 10,
+        "revenue": Decimal(100 + 3 * s * s - 2 * k * (1 + s % 3)),
+        "operating_cash_flow": Decimal(30 + 2 * s + s * s % 5 + k),
+        "capital_expenditure": Decimal(-(5 + 7 * s % 11)),  # reported as an outflow
+    }
+    return {
+        TEST_KEYS[name]: value
+        for name, value in items.items()
+        if line_items.LINE_ITEMS[name].statement_type == statement_type
+    }
+
+
+def add_fundamentals(
+    conn: psycopg.Connection,
+    instrument_id: int,
+    *,
+    latest_period_end: date,
+    first_observed_on: date,
+    filed_before_first: Collection[tuple[str, int]] = frozenset(),
+    quarters: int = 8,
+    extra_old_quarter_backfilled: bool = False,
+    statement_types: tuple[str, ...] = STATEMENT_TYPES,
+) -> list[date]:
+    """``quarters`` quarterly periods of each of ``statement_types``, newest first.
+
+    Quarter index 0 is ``latest_period_end`` and each older quarter is 3 calendar months
+    earlier. Every row is observed on ``first_observed_on`` and filed on it too (equal, so
+    not backfilled under DEC-0056's strict "earlier than"), except each
+    ``(statement_type, quarter_index)`` in ``filed_before_first``, filed ``BACKFILL_LEAD``
+    earlier (backfilled). ``extra_old_quarter_backfilled`` adds a ninth, backfilled
+    income statement 24 months before ``latest_period_end``, outside both windows. Each
+    period of each type is written once, so the stock's first ``observed_on`` is exactly
+    ``first_observed_on``. Returns the period ends, newest first.
+    """
+    ends = [months_before(latest_period_end, 3 * k) for k in range(quarters)]
+    backfilled_on = first_observed_on - BACKFILL_LEAD
+    for k, end in enumerate(ends):
+        for statement_type in statement_types:
+            add_statement(
+                conn,
+                instrument_id,
+                end,
+                statement_type,
+                statement_payload(instrument_id, statement_type, k),
+                observed_on=first_observed_on,
+                provider_filing_date=(
+                    backfilled_on
+                    if (statement_type, k) in filed_before_first
+                    else first_observed_on
+                ),
+            )
+    if extra_old_quarter_backfilled:
+        add_statement(
+            conn,
+            instrument_id,
+            months_before(latest_period_end, 24),
+            "income_statement",
+            statement_payload(instrument_id, "income_statement", 8),
+            observed_on=first_observed_on,
+            provider_filing_date=backfilled_on,
+        )
+    return ends
+
+
+def add_bar_for(conn: psycopg.Connection, instrument_id: int, session_date: date) -> None:
+    """A bar on ``session_date`` (close 10), so the stock's market capitalisation is defined."""
+    add_bar(conn, instrument_id, session_date)
+
+
+def _input_value(instrument_id: int, position: int) -> Decimal:
+    return Decimal(position + 1) + Decimal(instrument_id * (position + 3) % 11) / 100
+
+
+def add_marked_inputs(
+    conn: psycopg.Connection,
+    set_id: UUID,
+    instrument_id: int,
+    factor: str,
+    restated: bool = False,
+) -> None:
+    """A ``present`` ``factor_input`` row per input of the factor, in the shape of S5's
+    ``add_factor_inputs`` but with ``restated_possible`` set to ``restated``."""
+    rows = [
+        (
+            set_id,
+            instrument_id,
+            factor,
+            name,
+            _input_value(instrument_id, position),
+            _INPUT_DATE,
+            _INPUT_DATE,
+            restated,
+        )
+        for position, name in enumerate(constants.INPUT_NAMES[factor])
+    ]
+    with conn.cursor() as cur:
+        cur.executemany(_INSERT_INPUT, rows)
+    conn.commit()
+
+
+def add_momentum_inputs(
+    conn: psycopg.Connection, set_id: UUID, instrument_id: int, restated: bool = False
+) -> None:
+    """The three ``present`` momentum rows, with ``restated_possible`` set to ``restated``."""
+    add_marked_inputs(conn, set_id, instrument_id, "momentum", restated)
+
+
+def input_flags(conn: psycopg.Connection, set_id: UUID, instrument_id: int) -> dict[str, bool]:
+    """``restated_possible`` of each of the stock's ``factor_input`` rows, by input name."""
+    rows = conn.execute(
+        "SELECT input_name, restated_possible FROM factor_input "
+        "WHERE set_id = %s AND instrument_id = %s",
+        (set_id, instrument_id),
+    ).fetchall()
+    conn.commit()
+    return {name: flag for name, flag in rows}
+
+
+def classification_flags(conn: psycopg.Connection, set_id: UUID) -> dict[tuple[int, str], bool]:
+    """``restated_possible`` of every ``factor_classification`` row of the set."""
+    rows = conn.execute(
+        "SELECT instrument_id, factor, restated_possible FROM factor_classification "
+        "WHERE set_id = %s",
+        (set_id,),
+    ).fetchall()
+    conn.commit()
+    return {(instrument_id, factor): flag for instrument_id, factor, flag in rows}
+
+
+def snapshot(conn: psycopg.Connection, set_id: UUID) -> list[tuple[Any, ...]]:
+    """Every ``factor_classification`` row of the set, all columns, in primary-key order."""
+    rows = conn.execute(
+        "SELECT * FROM factor_classification WHERE set_id = %s "
+        "ORDER BY set_id, instrument_id, factor",
+        (set_id,),
+    ).fetchall()
+    conn.commit()
+    return rows
+
+
+def input_snapshot(conn: psycopg.Connection, set_id: UUID) -> list[tuple[Any, ...]]:
+    """Every ``factor_input`` row of the set, all columns, in primary-key order."""
+    rows = conn.execute(
+        "SELECT * FROM factor_input WHERE set_id = %s "
+        "ORDER BY set_id, instrument_id, factor, input_name",
+        (set_id,),
+    ).fetchall()
+    conn.commit()
+    return rows
diff --git a/tests/integration/test_engine_restatement.py b/tests/integration/test_engine_restatement.py
new file mode 100644
index 0000000..be07d99
--- /dev/null
+++ b/tests/integration/test_engine_restatement.py
@@ -0,0 +1,622 @@
+"""The possibly-restated mark on value and growth (CAP-002-E2-S6).
+
+A statement filed before the instrument's first fundamentals ``observed_on`` is backfilled
+(DEC-0056); the inputs that read it and the stock's value and growth classifications carry
+``restated_possible``, appended with the row, and momentum never does (DEC-0122). Satisfies
+AC-23, DAC-E2-11 and DAC-E2-S6-1 to DAC-E2-S6-3. The standard population is four active
+stocks A to D: every one of A's statements is backfilled, and B, C and D were observed as
+filed. Payload keys are the test keys of ``engine_inputs_support``.
+"""
+
+from collections.abc import Collection, Iterator, Mapping
+from datetime import date, timedelta
+from decimal import Decimal
+from typing import NamedTuple
+from uuid import UUID
+
+import psycopg
+import pytest
+
+from factorflow.classification import constants
+from tests.integration.engine_classify_support import (
+    classifications_for,
+    run_classification_build,
+)
+from tests.integration.engine_inputs_support import (
+    TEST_KEYS,
+    add_statement,
+    inputs_for,
+    months_before,
+)
+from tests.integration.engine_restatement_support import (
+    BACKFILL_LEAD,
+    MIN_FLOOR,
+    STATEMENT_TYPES,
+    add_bar_for,
+    add_fundamentals,
+    add_marked_inputs,
+    add_momentum_inputs,
+    all_rows,
+    classification_flags,
+    input_flags,
+    input_snapshot,
+    run_two_stage_build,
+    snapshot,
+    statement_payload,
+)
+from tests.integration.engine_support import (
+    add_building_set,
+    add_instrument,
+    add_run,
+    migrate_through_classification,
+)
+
+pytestmark = pytest.mark.postgres
+
+D = date(2026, 10, 17)  # classification date
+L = date(2026, 10, 16)  # latest trading day held
+P1 = date(2026, 9, 30)  # newest quarter, current against D
+FIRST = date(2026, 10, 1)  # every stock's first fundamentals observed_on
+PERIOD_ENDS = [months_before(P1, 3 * k) for k in range(8)]  # add_fundamentals' quarters
+
+FACTORS = constants.FACTORS
+VALUE = constants.INPUT_NAMES["value"]
+GROWTH = constants.INPUT_NAMES["growth"]
+FUNDAMENTAL_INPUTS = (*VALUE, *GROWTH)
+SYMBOLS = "ABCD"
+STANDARD = {"A": all_rows()}
+
+
+class Store(NamedTuple):
+    conn: psycopg.Connection
+    set_id: UUID
+
+
+@pytest.fixture
+def store(postgres_connection_string: str) -> Iterator[Store]:
+    """A store migrated through 0006 with a succeeded run and its ``building`` set."""
+    conn = migrate_through_classification(postgres_connection_string)
+    try:
+        yield Store(conn, add_building_set(conn, add_run(conn), D))
+    finally:
+        conn.close()
+
+
+def build_fixture(
+    conn: psycopg.Connection,
+    filed: Mapping[str, Collection[tuple[str, int]]] = STANDARD,
+    *,
+    extra_old: Collection[str] = (),
+    statement_types: Mapping[str, tuple[str, ...]] | None = None,
+) -> dict[str, int]:
+    """Active stocks A to D, each with a bar on ``L`` and eight quarters ending ``P1``
+    first observed on ``FIRST``; ``filed`` names each stock's backfilled rows."""
+    stocks: dict[str, int] = {}
+    for symbol in SYMBOLS:
+        stock = add_instrument(conn, symbol)
+        add_bar_for(conn, stock, L)
+        add_fundamentals(
+            conn,
+            stock,
+            latest_period_end=P1,
+            first_observed_on=FIRST,
+            filed_before_first=filed.get(symbol, frozenset()),
+            extra_old_quarter_backfilled=symbol in extra_old,
+            statement_types=(statement_types or {}).get(symbol, STATEMENT_TYPES),
+        )
+        stocks[symbol] = stock
+    return stocks
+
+
+def reobserve(
+    conn: psycopg.Connection,
+    stock: int,
+    statement_type: str,
+    quarter_index: int,
+    provider_filing_date: date | None,
+) -> None:
+    """A later observation of one of ``add_fundamentals``' rows, same payload, observed the
+    day after ``FIRST`` so the stock's first ``observed_on`` stays ``FIRST``."""
+    add_statement(
+        conn,
+        stock,
+        PERIOD_ENDS[quarter_index],
+        statement_type,
+        statement_payload(stock, statement_type, quarter_index),
+        observed_on=FIRST + timedelta(days=1),
+        provider_filing_date=provider_filing_date,
+    )
+
+
+def expect(*marked: str) -> dict[str, bool]:
+    """The five fundamentals inputs' flags with exactly ``marked`` true."""
+    return {name: name in marked for name in FUNDAMENTAL_INPUTS}
+
+
+def assert_column_agrees_with_detail(conn: psycopg.Connection, set_id: UUID, stock: int) -> None:
+    """DEC-0122: each input's mark is the ``or`` of the ``backfilled`` flags of the periods
+    its ``detail`` lists, and false when it lists none."""
+    for name, row in inputs_for(conn, set_id, stock).items():
+        periods = row["detail"].get("periods", [])
+        assert row["restated_possible"] is any(p["backfilled"] for p in periods), name
+
+
+# --- T004 ---------------------------------------------------------------------------------
+
+
+# Implements TC-COMP-186
+def test_statement_filed_before_first_observation_marks_its_inputs_and_classifications(
+    store: Store, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    conn, set_id = store
+    stocks = build_fixture(conn)
+
+    result = run_two_stage_build(conn, set_id, monkeypatch)
+
+    assert result.state == "complete", result.failure_reason
+    rows = classifications_for(conn, set_id)
+    a = stocks["A"]
+    assert input_flags(conn, set_id, a) == expect(*FUNDAMENTAL_INPUTS)
+    for factor in ("value", "growth"):
+        assert rows[(a, factor)]["status"] == "classified"
+        assert rows[(a, factor)]["restated_possible"] is True
+    # No momentum input exists in this build, so momentum is not ranked.
+    assert rows[(a, "momentum")]["status"] == "not_classified"
+    assert rows[(a, "momentum")]["restated_possible"] is False
+    for symbol in "BCD":
+        stock = stocks[symbol]
+        assert input_flags(conn, set_id, stock) == expect()
+        for factor in ("value", "growth"):
+            assert rows[(stock, factor)]["status"] == "classified"
+        assert {rows[(stock, f)]["restated_possible"] for f in FACTORS} == {False}
+    for stock in stocks.values():
+        assert_column_agrees_with_detail(conn, set_id, stock)
+
+
+# --- T005 ---------------------------------------------------------------------------------
+
+
+# Implements TC-COMP-187
+def test_momentum_classification_is_never_marked(
+    store: Store, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    conn, set_id = store
+    stocks = {symbol: add_instrument(conn, symbol) for symbol in SYMBOLS}
+    for symbol, stock in stocks.items():
+        add_bar_for(conn, stock, L)
+        marked = symbol == "A"
+        add_marked_inputs(conn, set_id, stock, "value", restated=marked)
+        add_marked_inputs(conn, set_id, stock, "growth", restated=marked)
+        # A's momentum rows say true too, a state no momentum stage writes, so only the
+        # factor guard in classify.sql can keep its classification unmarked.
+        add_momentum_inputs(conn, set_id, stock, restated=marked)
+    # E is marked on value and growth and has no momentum row, so its momentum row is the
+    # not-classified one of a ranked factor.
+    e = add_instrument(conn, "E")
+    add_bar_for(conn, e, L)
+    add_marked_inputs(conn, set_id, e, "value", restated=True)
+    add_marked_inputs(conn, set_id, e, "growth", restated=True)
+    monkeypatch.setattr(constants, "MIN_PEER_SET_SIZE", MIN_FLOOR)
+
+    result = run_classification_build(conn, set_id, monkeypatch)
+
+    assert result.state == "complete", result.failure_reason
+    rows = classifications_for(conn, set_id)
+    a = stocks["A"]
+    for factor in ("value", "growth"):
+        assert (rows[(a, factor)]["status"], rows[(a, factor)]["restated_possible"]) == (
+            "classified",
+            True,
+        )
+    momentum = rows[(a, "momentum")]
+    assert momentum["status"] == "classified"
+    assert momentum["score"] is not None
+    assert momentum["percentile"] is not None
+    assert momentum["restated_possible"] is False
+    assert [rows[(e, f)]["restated_possible"] for f in ("value", "growth")] == [True, True]
+    assert (rows[(e, "momentum")]["reason_code"], rows[(e, "momentum")]["restated_possible"]) == (
+        "input_missing",
+        False,
+    )
+    for symbol in "BCD":
+        assert {rows[(stocks[symbol], f)]["restated_possible"] for f in FACTORS} == {False}
+
+
+# --- T006 ---------------------------------------------------------------------------------
+
+D2 = date(2027, 1, 17)  # the later set's classification date
+L2 = date(2027, 1, 15)
+P0 = date(2026, 12, 31)  # a fresh quarter, newer than P1
