+        assert reason(rows[(stock, "momentum")]) == (
+            "not_classified",
+            "not_enough_stocks",
+            None,
+            "0 of 30 stocks qualified",
+            None,
+            None,
+        )
+
+
+def test_the_unranked_reason_states_the_floor_in_force(
+    store: Store, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """DEC-0120: the floor in ``reason_detail`` is ``constants.MIN_PEER_SET_SIZE``, read when
+    the stage runs, as is the floor ``ranked`` is judged against (AC-14)."""
+    conn, set_id = store.conn, store.set_id
+    add_full_roster(conn, set_id, 31)
+    monkeypatch.setattr(constants, "MIN_PEER_SET_SIZE", 32)
+
+    assert run_classification_build(conn, set_id, monkeypatch).state == "complete"
+
+    assert factor_counts_for(conn, set_id) == {factor: (31, False) for factor in FACTORS}
+    rows = classifications_for(conn, set_id)
+    assert len(rows) == 3 * 31
+    assert {row["reason_detail"] for row in rows.values()} == {"31 of 32 stocks qualified"}
diff --git a/tests/unit/test_classification_stage_order.py b/tests/unit/test_classification_stage_order.py
new file mode 100644
index 0000000..fe4a899
--- /dev/null
+++ b/tests/unit/test_classification_stage_order.py
@@ -0,0 +1,47 @@
+"""The classification stage runs after every input stage (CAP-002-E2-S5). No database.
+
+Design 2.2 and 2.6 order a build as inputs, peer sets, classification. The classification
+stage registers last, and a stage producing inputs is inserted above it (DEC-0121). Until
+CAP-002-E2-S3 and CAP-002-E2-S4 land no input stage exists and the order check holds
+vacuously; afterwards it is strict. Traces to DAC-E2-2.
+"""
+
+from collections.abc import Callable, Sequence
+
+from factorflow.classification import engine
+
+INPUT_STAGES = ("_fundamental_inputs_stage", "_momentum_inputs_stage")
+
+
+def input_stages_after_classification(stages: Sequence[Callable[..., object]]) -> list[str]:
+    names = [getattr(stage, "__name__", "") for stage in stages]
+    position = names.index("_classification_stage")
+    return [name for name in names[position + 1 :] if name in INPUT_STAGES]
+
+
+def test_the_rule_detects_an_input_stage_after_classification() -> None:
+    """DEC-0121: the order check can fail."""
+
+    def _classification_stage() -> None: ...
+
+    def _momentum_inputs_stage() -> None: ...
+
+    def _other_stage() -> None: ...
+
+    late = [_classification_stage, _other_stage, _momentum_inputs_stage]
+    assert input_stages_after_classification(late) == ["_momentum_inputs_stage"]
+    assert input_stages_after_classification([_momentum_inputs_stage, _classification_stage]) == []
+
+
+def test_the_classification_stage_is_registered() -> None:
+    """DEC-0121: ``build`` runs the classification stage."""
+    assert engine._classification_stage in engine._STAGES
+
+
+def test_no_input_stage_is_registered_after_the_classification_stage() -> None:
+    """DEC-0121, DAC-E2-2: inputs are written before peer sets are formed from them."""
+    late = input_stages_after_classification(engine._STAGES)
+    assert late == [], (
+        f"{late} run after _classification_stage: register an input stage above "
+        "`_STAGES.append(_classification_stage)` in engine.py, never after it (DEC-0121)"
+    )
diff --git a/tests/unit/test_classify_sql_static.py b/tests/unit/test_classify_sql_static.py
new file mode 100644
index 0000000..5f6368a
--- /dev/null
+++ b/tests/unit/test_classify_sql_static.py
@@ -0,0 +1,186 @@
+"""The classification statements' static contract (CAP-002-E2-S5). No database.
+
+``peer_sets.sql`` and ``classify.sql`` read ``factor_input`` and never a universe table or the
+``inputs`` temporary table (DEC-0119; the "no universe table is read" half of DAC-E2-S5-5),
+take only the stage's named parameters, and do their arithmetic with PostgreSQL window
+functions, with no numeric library anywhere in the package (DEC-0052). The input labels have
+one table, ``constants.INPUT_LABELS``, which reaches ``classify.sql`` as a bound array
+(DEC-0120, DEC-0130; STD-UI-1). Traces to AC-8, DEC-0052, DEC-0119 and DEC-0120.
+"""
+
+import ast
+import re
+from pathlib import Path
+
+import pytest
+
+from factorflow.classification import constants
+
+PACKAGE = Path(constants.__file__).parent
+SQL_DIR = PACKAGE / "sql"
+STATEMENTS = ("peer_sets.sql", "classify.sql")
+STAGE_PARAMETERS = {
+    "set_id",
+    "factor",
+    "factors",
+    "input_names",
+    "input_labels",
+    "input_counts",
+    "min_peer_set_size",
+    "active_ids",
+    "retired_ids",
+}
+NUMERIC_LIBRARIES = {"numpy", "scipy", "pandas", "statistics"}
+LABELS = {
+    "book_to_price": "book-to-price",
+    "earnings_yield": "earnings yield",
+    "fcf_yield": "free-cash-flow yield",
+    "revenue_growth": "revenue growth",
+    "eps_growth": "earnings-per-share growth",
+    "return_3m": "3-month total return",
+    "return_6m": "6-month total return",
+    "return_12m": "12-month total return",
+}
+
+
+def statement(name: str) -> str:
+    return (SQL_DIR / name).read_text()
+
+
+def numeric_imports(source: str) -> list[str]:
+    found: list[str] = []
+    for node in ast.walk(ast.parse(source)):
+        if isinstance(node, ast.Import):
+            found += [a.name for a in node.names if a.name.split(".")[0] in NUMERIC_LIBRARIES]
+        elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
+            if node.module.split(".")[0] in NUMERIC_LIBRARIES:
+                found.append(node.module)
+    return found
+
+
+def names_inputs_table(text: str) -> bool:
+    return re.search(r"\b(?:FROM|JOIN)\s+inputs\b", text, re.IGNORECASE) is not None
+
+
+def written_tables(text: str) -> set[str]:
+    pattern = r"\b(?:INSERT\s+INTO|UPDATE|DELETE\s+FROM)\s+(\w+)"
+    return {table.lower() for table in re.findall(pattern, text, re.IGNORECASE)}
+
+
+def parameters(text: str) -> set[str]:
+    return set(re.findall(r"%\((\w+)\)s", text))
+
+
+# --- the rules can fail -----------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "source",
+    [
+        "import numpy",
+        "import numpy as np",
+        "import scipy.stats",
+        "from pandas.core import frame",
+        "from statistics import stdev",
+    ],
+)
+def test_numeric_import_is_detected(source: str) -> None:
+    """DEC-0052: the numeric-library check can fail."""
+    assert numeric_imports(source)
+
+
+def test_other_imports_are_allowed() -> None:
+    """DEC-0052: the check does not flag other imports."""
+    assert not numeric_imports("import decimal\nfrom . import statistics_like\nimport math")
+
+
+@pytest.mark.parametrize("text", ["SELECT 1 FROM inputs i", "x JOIN inputs USING (a)"])
+def test_inputs_table_is_detected(text: str) -> None:
+    """DEC-0119: the ``inputs`` check can fail."""
+    assert names_inputs_table(text)
+
+
+def test_factor_input_and_a_cte_named_inp_are_not_the_inputs_table() -> None:
+    """DEC-0119: ``factor_input`` and a CTE named ``inp`` are not the ``inputs`` table."""
+    assert not names_inputs_table("SELECT 1 FROM factor_input fi CROSS JOIN inp i")
+
+
+def test_written_tables_are_found() -> None:
+    """DEC-0119: the written-table check sees INSERT, UPDATE and DELETE targets."""
+    text = "INSERT INTO a (x) SELECT 1; update B SET x = 1; DELETE FROM c"
+    assert written_tables(text) == {"a", "b", "c"}
+
+
+# --- the statements obey them -----------------------------------------------------------
+
+
+@pytest.mark.parametrize("name", STATEMENTS)
+def test_statement_exists(name: str) -> None:
+    """DEC-0121: the stage's two statements ship in ``classification/sql``."""
+    assert (SQL_DIR / name).is_file()
+    assert statement(name).strip()
+
+
+@pytest.mark.parametrize("name", STATEMENTS)
+def test_statement_never_names_a_universe_table(name: str) -> None:
+    """AC-8, DAC-E2-S5-5: no universe table is read, so membership cannot move a score."""
+    assert "universe" not in statement(name).lower()
+
+
+@pytest.mark.parametrize("name", STATEMENTS)
+def test_statement_reads_factor_input_and_not_the_inputs_table(name: str) -> None:
+    """DEC-0119: the statements read ``factor_input``, never the ``inputs`` temporary table."""
+    text = statement(name)
+    assert re.search(r"\b(?:FROM|JOIN)\s+factor_input\b", text, re.IGNORECASE)
+    assert not names_inputs_table(text)
+
+
+@pytest.mark.parametrize("name", STATEMENTS)
+def test_statement_takes_only_the_stage_parameters(name: str) -> None:
+    """DEC-0119, DEC-0120: only the stage's ``%(name)s`` parameters, never interpolation."""
+    text = statement(name)
+    assert parameters(text) <= STAGE_PARAMETERS
+    assert re.search(r"%(?!\(\w+\)s)", text) is None
+
+
+def test_classify_does_its_arithmetic_with_window_functions() -> None:
+    """DEC-0052, DEC-0053: PostgreSQL window functions do the arithmetic."""
+    text = statement("classify.sql")
+    for function in ("stddev_samp", "percent_rank", "avg"):
+        assert re.search(rf"\b{function}\s*\(", text), function
+
+
+def test_each_statement_writes_only_its_own_table() -> None:
+    """DEC-0119: each statement inserts into its one table and changes no other."""
+    assert written_tables(statement("peer_sets.sql")) == {"classification_set_factor"}
+    assert written_tables(statement("classify.sql")) == {"factor_classification"}
+
+
+def test_no_classification_module_imports_a_numeric_library() -> None:
+    """DEC-0052: no numeric library anywhere in the package."""
+    modules = sorted(PACKAGE.rglob("*.py"))
+    assert modules
+    assert {p.name: numeric_imports(p.read_text()) for p in modules} == {
+        p.name: [] for p in modules
+    }
+
+
+def test_input_labels_cover_exactly_the_input_names() -> None:
+    """DEC-0130: one label per input name, and no other key."""
+    names = {name for names in constants.INPUT_NAMES.values() for name in names}
+    assert set(constants.INPUT_LABELS) == names
+
+
+def test_input_labels_are_the_product_vocabulary() -> None:
+    """DEC-0120, DEC-0130, STD-UI-1: product vocabulary, never a payload key."""
+    assert constants.INPUT_LABELS == LABELS
+    for name, label in constants.INPUT_LABELS.items():
+        assert label != name
+        assert "_" not in label
+
+
+def test_classify_holds_no_label_text() -> None:
+    """DEC-0120: the labels have one table; ``classify.sql`` receives them bound."""
+    text = statement("classify.sql")
+    assert [label for label in LABELS.values() if label in text] == []
+    assert "replace(" not in text.lower()
diff --git a/tests/unit/test_composite_arithmetic.py b/tests/unit/test_composite_arithmetic.py
new file mode 100644
index 0000000..b9c46ab
--- /dev/null
+++ b/tests/unit/test_composite_arithmetic.py
@@ -0,0 +1,278 @@
+"""The composite arithmetic of DEC-0053, run through the real statements (CAP-002-E2-S5).
+
+The arithmetic exists only as SQL, so these tests run ``peer_sets.sql`` and ``classify.sql``
+through ``engine._classification_stage`` on PostgreSQL and compare the rows with literal values
+and with ``reference_scores``, a pure-Python oracle. Every case runs in a transaction rolled
+back at its end, with the peer-set floor patched to 3 so hand-built peer sets stay small (the
+floor of 30 is TC-COMP-107's). Traces to DAC-E2-S5-1, DAC-E2-3 and AC-9.
+"""
+
+import uuid
+from collections.abc import Iterator, Sequence
+from decimal import Decimal
+from typing import NamedTuple
+from unittest.mock import patch
+from uuid import UUID
+
+import psycopg
+import pytest
+from hypothesis import assume, given, settings
+from hypothesis import strategies as st
+from psycopg import sql
+
+from factorflow.classification import constants, engine
+from tests.integration.engine_classify_support import (
+    SCORE_PLACES,
+    add_terminal_run_and_set,
+    insert_factor_inputs,
+    insert_instrument,
+    make_context,
+    reference_composite_dispersion,
+    reference_scores,
+)
+from tests.integration.engine_support import migrate_through_classification
+
+pytestmark = pytest.mark.postgres
+
+Result = tuple[Decimal, Decimal]
+
+
+class Store(NamedTuple):
+    conn: psycopg.Connection
+    run_id: UUID
+    set_id: UUID
+
+
+@pytest.fixture(scope="module")
+def store(_postgres_admin_connection_string: str) -> Iterator[Store]:
+    """One database for the module, holding a succeeded run and its ``building`` set; the
+    cases add their stocks inside transactions they roll back."""
+    name = f"test_{uuid.uuid4().hex}"
+    admin = psycopg.connect(_postgres_admin_connection_string, autocommit=True)
+    try:
+        admin.execute(sql.SQL("CREATE DATABASE {}").format(sql.Identifier(name)))
+        base_url = _postgres_admin_connection_string.rsplit("/", 1)[0]
+        conn = migrate_through_classification(f"{base_url}/{name}")
+        try:
+            run_id, set_id = add_terminal_run_and_set(conn)
+            yield Store(conn, run_id, set_id)
+        finally:
+            conn.close()
+    finally:
+        try:
+            admin.execute(
+                "SELECT pg_terminate_backend(pid) FROM pg_stat_activity "
+                "WHERE datname = %s AND pid <> pg_backend_pid()",
+                (name,),
+            )
+            admin.execute(sql.SQL("DROP DATABASE IF EXISTS {}").format(sql.Identifier(name)))
+        finally:
+            admin.close()
+
+
+def classify(store: Store, factor: str, stocks: Sequence[Sequence[Decimal]]) -> list[Result]:
+    """Classify ``stocks``, each the factor's input values in ``INPUT_NAMES`` order, in a
+    transaction rolled back at its end; each stock's ``(score, percentile)`` in order."""
+    conn = store.conn
+    results: list[Result] = []
+    with conn.transaction():
+        with conn.cursor() as cur:
+            ids = []
+            for position, values in enumerate(stocks):
+                instrument_id = insert_instrument(cur, f"H{position:03d}", "active")
+                insert_factor_inputs(cur, store.set_id, instrument_id, factor, values)
+                ids.append(instrument_id)
+            with patch.object(constants, "MIN_PEER_SET_SIZE", 3):
+                engine._classification_stage(
+                    conn, make_context(store.set_id, store.run_id, ids, ())
+                )
+            cur.execute(
+                "SELECT instrument_id, status, score, percentile FROM factor_classification "
+                "WHERE set_id = %s AND factor = %s",
+                (store.set_id, factor),
+            )
+            found = {row[0]: row[1:] for row in cur.fetchall()}
+        assert sorted(found) == sorted(ids)
+        assert {status for status, _, _ in found.values()} == {"classified"}
+        results = [(found[i][1], found[i][2]) for i in ids]
+        raise psycopg.Rollback
+    return results
+
+
+def growth(first: Sequence[int], second: Sequence[int]) -> list[list[Decimal]]:
+    """Stocks on ``growth``, the factor with two inputs: ``revenue_growth``, then
+    ``eps_growth`` (``constants.INPUT_NAMES``)."""
+    return [[Decimal(a), Decimal(b)] for a, b in zip(first, second, strict=True)]
+
+
+def literal(*pairs: tuple[str, str]) -> list[Result]:
+    return [(Decimal(score), Decimal(percentile)) for score, percentile in pairs]
+
+
+def test_cases_name_the_growth_inputs_in_order() -> None:
+    """DAC-E2-S5-1: the hand-built cases give ``revenue_growth`` first, ``eps_growth`` second."""
+    assert constants.INPUT_NAMES["growth"] == ("revenue_growth", "eps_growth")
+
+
+# Implements TC-COMP-069
+def test_common_z_scores_are_already_standardised(store: Store) -> None:
+    """(a) Both inputs have the same z-scores, (v - 3) / sqrt(2.5) with the sample standard
+    deviation, so the composite equals them and re-standardising leaves it unchanged."""
+    results = classify(store, "growth", growth([1, 2, 3, 4, 5], [10, 20, 30, 40, 50]))
+
+    assert results == literal(
+        ("-1.264911", "0"),
+        ("-0.632456", "25"),
+        ("0", "50"),
+        ("0.632456", "75"),
+        ("1.264911", "100"),
+    )
+
+
+# Implements TC-COMP-069
+def test_uncorrelated_inputs_are_re_standardised(store: Store) -> None:
+    """(b) Deviations x1 = (-2, -1, 0, 1, 2) and x2 = (1, -2, 0, 2, -1) from the mean 3 are
+    uncorrelated (sum x1 * x2 = 0). The composite (x1 + x2) / (2 sqrt(2.5)) has sample
+    standard deviation sqrt(2) / 2, not 1, so re-standardising rescales it to
+    (x1 + x2) / sqrt(5)."""
+    first, second = [1, 2, 3, 4, 5], [4, 1, 3, 5, 2]
+    x1, x2 = [v - 3 for v in first], [v - 3 for v in second]
+    assert sum(a * b for a, b in zip(x1, x2, strict=True)) == 0
+    sums = [a + b for a, b in zip(x1, x2, strict=True)]  # -1, -3, 0, 3, 1
+    composite = [Decimal(s) / (2 * Decimal("2.5").sqrt()) for s in sums]
+    composite_sd = (sum((c * c for c in composite), Decimal(0)) / 4).sqrt()
+    assert abs(composite_sd - Decimal(2).sqrt() / 2) < Decimal("1e-20")
+    scores = [(Decimal(s) / Decimal(5).sqrt()).quantize(SCORE_PLACES) for s in sums]
+    percentiles = [Decimal(p) for p in (25, 0, 50, 100, 75)]
+
+    results = classify(store, "growth", growth(first, second))
+
+    assert results == list(zip(scores, percentiles, strict=True))
+    assert scores == [Decimal(s) for s in ("-0.447214", "-1.341641", "0", "1.341641", "0.447214")]
+    oracle = reference_scores(dict(enumerate(growth(first, second))))
+    assert all(
+        abs(results[i][0] - oracle[i][0]) <= SCORE_PLACES and results[i][1] == oracle[i][1]
+        for i in range(5)
+    )
+
+
+# Implements TC-COMP-069
+def test_a_zero_dispersion_input_contributes_zero(store: Store) -> None:
+    """(c) ``eps_growth`` is 7 for every stock: its z-score is 0, so the composite is half
+    the other input's z-score, and re-standardising returns that z-score."""
+    results = classify(store, "growth", growth([1, 2, 3, 4, 5], [7, 7, 7, 7, 7]))
+
+    assert results == literal(
+        ("-1.264911", "0"),
+        ("-0.632456", "25"),
+        ("0", "50"),
+        ("0.632456", "75"),
+        ("1.264911", "100"),
+    )
+
+
+# Implements TC-COMP-069
+def test_every_input_without_dispersion_scores_zero_without_dividing_by_zero(
+    store: Store,
+) -> None:
+    """(d) Both inputs are constant: every z-score, composite and score is 0, and the tied
+    stocks all take percentile 0."""
+    results = classify(store, "growth", growth([2, 2, 2, 2, 2], [9, 9, 9, 9, 9]))
+
+    assert results == literal(*[("0", "0")] * 5)
+
+
+# Implements TC-COMP-069
+def test_opposite_inputs_cancel_to_a_constant_composite(store: Store) -> None:
+    """(e) ``eps_growth`` is minus ``revenue_growth``: the z-scores cancel exactly, the
+    composite is 0 for every stock and its zero dispersion gives score 0."""
+    a = [1, 2, 4, 8, 16]
+
+    results = classify(store, "growth", growth(a, [-v for v in a]))
+
+    assert results == literal(*[("0", "0")] * 5)
+
+
+# --- properties over random peer sets -----------------------------------------------------
+
+VALUES = st.decimals(
+    min_value=-1000, max_value=1000, places=4, allow_nan=False, allow_infinity=False
+)
+
+
+@st.composite
+def peer_sets(draw: st.DrawFn) -> tuple[str, list[list[Decimal]]]:
+    """A factor and 3 to 12 stocks, each with one value per input of the factor; every input
+    column holds distinct values."""
+    factor = draw(st.sampled_from(constants.FACTORS))
+    n = draw(st.integers(min_value=3, max_value=12))
+    columns = [
+        draw(st.lists(VALUES, min_size=n, max_size=n, unique=True))
+        for _ in constants.INPUT_NAMES[factor]
+    ]
+    return factor, [list(row) for row in zip(*columns, strict=True)]
+
+
+def close(left: Sequence[Result], right: Sequence[Result]) -> bool:
+    return len(left) == len(right) and all(
+        abs(a[0] - b[0]) <= Decimal("2e-6") and abs(a[1] - b[1]) <= Decimal("1e-5")
+        for a, b in zip(left, right, strict=True)
+    )
+
+
+# Implements TC-COMP-069
+@settings(deadline=None, max_examples=40)
+@given(case=peer_sets(), data=st.data())
+def test_properties_hold_over_random_peer_sets(
+    store: Store, case: tuple[str, list[list[Decimal]]], data: st.DataObject
+) -> None:
+    factor, stocks = case
+    n = len(stocks)
+    # Distinct values do not rule out inputs whose z-scores cancel, as A and -2A + 1 do. Their
+    # composite is constant, numeric rounding leaves it a spread near 1e-17, and
+    # re-standardising turns that into noise. That is the plan's open gap, left to the owner,
+    # so the examples avoid it rather than assert on it (T013). Hand-built cases (d) and (e)
+    # cover the exactly constant composite.
+    assume(reference_composite_dispersion(dict(enumerate(stocks))) >= Decimal("1e-9"))
+    with store.conn.transaction():
+        results = classify(store, factor, stocks)
+
+        oracle = reference_scores(dict(enumerate(stocks)))
+        assert close(results, [oracle[i] for i in range(n)])
+
+        scores = [score for score, _ in results]
+        mean = sum(scores, Decimal(0)) / n
+        sd = (sum(((s - mean) ** 2 for s in scores), Decimal(0)) / (n - 1)).sqrt()
+        assert abs(mean) <= Decimal("1e-5")
+        assert abs(sd - 1) <= Decimal("1e-5")
+
+        ordered = sorted(results)
+        assert all(0 <= percentile <= 100 for _, percentile in results)
+        assert all(low[1] <= high[1] for low, high in zip(ordered, ordered[1:], strict=False))
+        assert ordered[0][1] == 0
+        top = max(score for score, _ in oracle.values())
+        if sum(1 for score, _ in oracle.values() if score == top) == 1:
+            assert ordered[-1][1] == 100  # tied top scores share the lowest rank
+
+        # Adding a constant to one input changes no score, nor does multiplying it by a
+        # positive constant. Only scores: two stocks whose composites tie exactly (one's
+        # inputs are the other's, swapped between two inputs holding the same values) can
+        # differ by a rounding error once one input is moved, and percent_rank orders them.
+        k = data.draw(st.integers(min_value=0, max_value=len(stocks[0]) - 1), label="input")
+        shift = data.draw(st.decimals(min_value=-100, max_value=100, places=4), label="shift")
+        scale = data.draw(st.decimals(min_value="0.01", max_value=100, places=2), label="scale")
+        for moved in (
+            [[v + shift if j == k else v for j, v in enumerate(s)] for s in stocks],
+            [[v * scale if j == k else v for j, v in enumerate(s)] for s in stocks],
+        ):
+            moved_scores = [score for score, _ in classify(store, factor, moved)]
+            assert all(
+                abs(after - before) <= Decimal("2e-6")
+                for after, before in zip(moved_scores, scores, strict=True)
