        [
            ("split", {"split_from": "1", "split_to": "0"}),
            ("split", {"split_from": "0", "split_to": "2"}),
            ("split", {"split_from": "-1", "split_to": "2"}),
            ("split", {"split_from": "abc", "split_to": "2"}),
