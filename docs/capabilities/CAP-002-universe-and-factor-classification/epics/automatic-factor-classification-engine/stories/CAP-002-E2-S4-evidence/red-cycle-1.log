            env.conn, env.stock, "dividend", ex_date, {"cash_amount": "2"}, ex_date, late
        )
        add_corporate_action(
            env.conn, env.stock, "dividend", ex_date, {"cash_amount": "1"}, ex_date, early
        )
    
