@@ -350,6 +372,30 @@ def test_reclaim_runs_even_when_the_stop_event_is_already_set(
     assert waiter.delays == []
 
 
+def test_raising_reclaim_propagates_before_any_claim(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """DAC-E2-12, DAC-E2-S9-3: the start-up reclaim sits outside the iteration handler
+    (design 2.4), so when it raises the exception ends the loop and no claim is ever
+    attempted, and nothing is waited for (plan, Open Gaps: no retry is added)."""
+    unreachable = OSError("db unreachable")
+    _Fakes(monkeypatch, claim=_scripted())
+
+    def raising_reclaim(pool: Any) -> list[Any]:
+        raise unreachable
+
+    monkeypatch.setattr(scheduler, "reclaim_interrupted_sets", raising_reclaim)
+    waiter = _RecordingWaiter(stop_after=1)
+    dispatcher = _RecordingDispatcher()
+
+    with pytest.raises(OSError) as raised:
+        _run_loop(MagicMock(name="pool"), _settings(5.0, 300.0), waiter, dispatcher)
+
+    assert raised.value is unreachable
+    assert dispatcher.fns == [raising_reclaim]
+    assert waiter.delays == []
+
+
