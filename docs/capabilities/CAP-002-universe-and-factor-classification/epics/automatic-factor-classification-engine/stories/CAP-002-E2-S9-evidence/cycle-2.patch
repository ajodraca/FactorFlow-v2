     assert waiter.delays == [5.0]
 
 
+def test_stop_event_set_during_a_successful_build_claims_again_before_stopping(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """DAC-E2-S9-1, AC-11: no stop check follows a build (design 2.4; plan T012 and Other
+    Notes, stop event, E2-F26), so a stop event set during a successful build is first
+    seen at the idle stop check: the loop claims again at once and stops before waiting."""
+    claimed = _claimed()
+    waiter = _RecordingWaiter(stop_after=1)
+
+    def stopping_build(pool: Any, set_id: UUID, timeout_seconds: float) -> BuildResult:
+        waiter.stop.set()
+        return _result("complete", set_id)
+
+    fakes = _Fakes(monkeypatch, claim=_scripted(claimed), build=stopping_build)
+    dispatcher = _RecordingDispatcher()
+
+    _run_loop(MagicMock(name="pool"), _settings(5.0, 300.0), waiter, dispatcher)
+
+    assert dispatcher.fns == [fakes.reclaim, fakes.claim, fakes.build, fakes.claim]
+    assert waiter.delays == []
+
+
