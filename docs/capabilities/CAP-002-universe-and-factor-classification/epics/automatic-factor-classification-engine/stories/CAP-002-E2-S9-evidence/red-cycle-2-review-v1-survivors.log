    def test_raising_reclaim_propagates_before_any_claim(
        monkeypatch: pytest.MonkeyPatch,
    ) -> None:
        """DAC-E2-12, DAC-E2-S9-3: the start-up reclaim sits outside the iteration handler
        (design 2.4), so when it raises the exception ends the loop and no claim is ever
        attempted, and nothing is waited for (plan, Open Gaps: no retry is added)."""
