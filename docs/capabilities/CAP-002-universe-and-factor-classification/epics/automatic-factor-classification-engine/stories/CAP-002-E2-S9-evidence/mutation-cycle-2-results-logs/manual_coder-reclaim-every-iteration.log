    @pytest.mark.parametrize("state", ["complete", "failed"])
    def test_build_outcome_is_logged_at_info_without_raising(
        monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture, state: str
    ) -> None:
        """AC-20, AC-10: the engine records the outcome itself, so the loop logs the set, the
        run and ``result.state`` at INFO (design 2.4; design section 4, Audit), logs no error,
        and looks again at once. Both outcomes are pinned, so a fixed state cannot pass."""
        claimed = _claimed()
    
        def build(pool: Any, set_id: UUID, timeout_seconds: float) -> BuildResult:
            return _result(state, set_id)
    
        fakes = _Fakes(monkeypatch, claim=_scripted(claimed), build=build)
        dispatcher = _RecordingDispatcher()
    
        with caplog.at_level(logging.INFO, logger=LOGGER):
            _run_loop(MagicMock(name="pool"), _settings(), _RecordingWaiter(), dispatcher)
    
        infos = [r.getMessage() for r in _scheduler_records(caplog, logging.INFO)]
        assert infos == [f"classification set {claimed.set_id} for run {claimed.run_id} ended {state}"]
        assert _scheduler_records(caplog, logging.ERROR) == []
