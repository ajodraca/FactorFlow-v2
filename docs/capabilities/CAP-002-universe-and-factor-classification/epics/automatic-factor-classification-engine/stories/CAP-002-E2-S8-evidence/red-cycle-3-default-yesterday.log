postgres_connection_string = 'postgresql://test:test@localhost:52168/test_66daa670540b476db283aede1d256dc9'
session_zone = 'UTC'

    @pytest.mark.parametrize("session_zone", ["UTC", "Etc/GMT+4", "Etc/GMT-14"])
    def test_claim_without_at_stamps_the_database_clock_chicago_date(
        postgres_connection_string: str, session_zone: str
    ) -> None:
        migrate_all(postgres_connection_string)
        pool: ConnectionPool[Any] = ConnectionPool(
            postgres_connection_string,
            min_size=1,
            max_size=2,
            kwargs={"options": f"-c TimeZone={session_zone}"},
            open=True,
        )
        conn = psycopg.connect(postgres_connection_string)
        try:
            add_run(conn, "succeeded")
    
            claimed = claim_next_set(pool)
    
            assert claimed is not None
            with conn.cursor() as cur:
                cur.execute(
                    "SELECT classification_date, (started_at AT TIME ZONE 'America/Chicago')::date "
                    "FROM classification_set WHERE set_id = %s",
                    (claimed.set_id,),
                )
                row = cur.fetchone()
            conn.rollback()
        finally:
            conn.close()
            pool.close()
        assert row is not None
        stamped, expected = row
        # started_at defaults to now(), the claim transaction's own timestamp, so no Chicago midnight
        # can fall between the two reads.
>       assert stamped == expected
E       assert datetime.date(2026, 10, 23) == datetime.date(2026, 10, 24)

