            ([(S6 + ONE_DAY, E)], ("return_3m", "return_6m")),
            ([(S6 + 2 * ONE_DAY, E)], ("return_3m",)),
            ([(S12 + ONE_DAY, E - ONE_DAY)], ()),
            ([(S6 + 2 * ONE_DAY, E), (S12 + ONE_DAY, S6)], ("return_3m",)),
