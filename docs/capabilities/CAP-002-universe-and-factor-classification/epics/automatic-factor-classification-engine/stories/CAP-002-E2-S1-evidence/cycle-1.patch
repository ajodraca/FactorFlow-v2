+    assert columns[("factor_classification", "score")] == ("numeric", 18, 6, "YES")
+    assert columns[("factor_classification", "percentile")] == ("numeric", 9, 6, "YES")
+    assert columns[("factor_input", "detail")] == ("jsonb", None, None, "NO")
