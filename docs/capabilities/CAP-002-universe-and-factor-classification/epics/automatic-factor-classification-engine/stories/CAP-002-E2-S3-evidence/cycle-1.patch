+def resolve_only(monkeypatch: pytest.MonkeyPatch, *names: str) -> None:
+    """Resolve the named line items to their test keys; the rest stay ``REQUIRES_INPUT``."""
+    for name in names:
+        item = line_items.LINE_ITEMS[name]
+        monkeypatch.setitem(
