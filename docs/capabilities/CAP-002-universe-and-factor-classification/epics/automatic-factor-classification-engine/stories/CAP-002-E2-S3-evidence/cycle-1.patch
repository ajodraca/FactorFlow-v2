diff --git a/src/factorflow/classification/engine.py b/src/factorflow/classification/engine.py
index 8ca22c4..4961cc3 100644
--- a/src/factorflow/classification/engine.py
+++ b/src/factorflow/classification/engine.py
@@ -21,12 +21,19 @@ from uuid import UUID
 
 import psycopg
 
+from factorflow.classification import constants, line_items
+
 log = logging.getLogger(__name__)
 
 _SQL_DIR = Path(__file__).parent / "sql"
 _SET_CONTEXT_SQL: Final = (_SQL_DIR / "set_context.sql").read_text()
 _COMPLETE_SET_SQL: Final = (_SQL_DIR / "complete_set.sql").read_text()
 _FAIL_SET_SQL: Final = (_SQL_DIR / "fail_set.sql").read_text()
+# The fundamentals stage (CAP-002-E2-S3).
+_STATEMENTS_SQL: Final = (_SQL_DIR / "statements.sql").read_text()
+_VALUE_INPUTS_SQL: Final = (_SQL_DIR / "value_inputs.sql").read_text()
+_GROWTH_INPUTS_SQL: Final = (_SQL_DIR / "growth_inputs.sql").read_text()
+_INSERT_INPUTS_SQL: Final = (_SQL_DIR / "insert_inputs.sql").read_text()
 _QUALIFIED_COUNTS_SQL: Final = (
     "SELECT factor, qualified_count FROM classification_set_factor WHERE set_id = %(set_id)s"
 )
@@ -149,3 +156,52 @@ def build(conn: psycopg.Connection, set_id: UUID, timeout_seconds: float) -> Bui
         active_instruments=len(context.active_ids),
         qualified_counts=qualified_counts,
     )
+
+
+def _line_item_parameters() -> dict[str, object]:
+    """The seven line items as parallel arrays of bound parameters (SEC-INP-002).
+
+    Read from ``line_items.LINE_ITEMS`` at call time. A ``REQUIRES_INPUT`` key is passed as
+    ``None``, so the sentinel never reaches SQL and the inputs that need it are ``missing``
+    with ``unresolved_cause`` (factor-engine design 2.4).
+    """
+    items = line_items.LINE_ITEMS
+    return {
+        "line_item_names": list(items),
+        "line_item_statement_types": [item.statement_type for item in items.values()],
+        "line_item_keys": [
+            None if item.payload_key == line_items.REQUIRES_INPUT else item.payload_key
+            for item in items.values()
+        ],
+        "line_item_signs": [item.sign for item in items.values()],
+        "unresolved": line_items.unresolved(),
+        "unresolved_cause": line_items.UNRESOLVED_CAUSE,
+    }
+
+
+def _fundamental_inputs_stage(conn: psycopg.Connection, ctx: BuildContext) -> None:
+    """Derive the value and growth inputs of every active instrument and append them.
+
+    Implements factor-engine design 2.3 steps 3 to 5 and 2.4 for the value and growth
+    factors (CAP-002-E2-S3; DEC-0115): ``statements.sql`` fills the temporary table
+    ``stmt``, ``value_inputs.sql`` creates ``inputs``, ``growth_inputs.sql`` adds to it and
+    ``insert_inputs.sql`` writes the two factors' rows to ``factor_input``.
+    """
+    params = {
+        "set_id": ctx.set_id,
+        "active_ids": list(ctx.active_ids),
+        "classification_date": ctx.classification_date,
+        "latest_trading_day": ctx.latest_trading_day,
+        "stale_months": constants.FUNDAMENTALS_STALE_AFTER_MONTHS,
+        **_line_item_parameters(),
+    }
+    with conn.cursor() as cur:
+        cur.execute(_STATEMENTS_SQL, params)
+        cur.execute(_VALUE_INPUTS_SQL, params)
+        cur.execute(_GROWTH_INPUTS_SQL, params)
+        cur.execute(_INSERT_INPUTS_SQL, {"set_id": ctx.set_id, "factors": ["value", "growth"]})
+
+
+# Input-producing stages are registered here, above CAP-002-E2-S5's classification stage
+# when it is present (DEC-0121): fundamentals, then CAP-002-E2-S4's momentum.
+_STAGES.append(_fundamental_inputs_stage)
diff --git a/src/factorflow/classification/sql/growth_inputs.sql b/src/factorflow/classification/sql/growth_inputs.sql
new file mode 100644
index 0000000..40bae1f
--- /dev/null
+++ b/src/factorflow/classification/sql/growth_inputs.sql
@@ -0,0 +1,125 @@
+-- revenue_growth and eps_growth for every active instrument: the trailing four quarters
+-- over the four quarters a year earlier, minus one (factor-engine design 2.4;
+-- DEC-0055 (1), (2), (7); DEC-0116). Inserts into the temporary table value_inputs.sql
+-- creates (DEC-0115). Depends on no price. Reads only. CAP-002-E2-S3.
+INSERT INTO inputs (instrument_id, factor, input_name, status, value, as_of, known_on,
+                    restated_possible, detail, missing_data_type)
+WITH roster AS (
+    SELECT unnest(%(active_ids)s::bigint[]) AS instrument_id
+),
+line_item AS (
+    -- The seven line items with their bound payload keys and signs. A NULL key is one the
+    -- owner has not supplied yet (line_items.REQUIRES_INPUT).
+    SELECT m.name, m.payload_key, m.sign
+      FROM unnest(%(line_item_names)s::text[], %(line_item_keys)s::text[],
+                  %(line_item_signs)s::integer[])
+           AS m (name, payload_key, sign)
+),
+needed (input_name, line_item) AS (
+    VALUES ('revenue_growth', 'revenue'), ('eps_growth', 'diluted_eps')
+),
+used AS (
+    -- The eight quarterly income statements of the trailing and prior-year windows, each
+    -- line item read through the guard of value_inputs.sql (DEC-0116 (4)).
+    SELECT r.instrument_id, n.input_name, s.fiscal_period_end, s.observed_on,
+           s.ttm_slot IS NOT NULL AS in_ttm,
+           jsonb_build_object('statement_type', s.statement_type,
+                              'fiscal_period_end', s.fiscal_period_end,
+                              'observed_on', s.observed_on,
+                              'provider_filing_date', s.provider_filing_date,
+                              'backfilled', s.backfilled) AS period,
+           CASE WHEN jsonb_typeof(s.payload -> m.payload_key) IN ('number', 'string')
+                 AND s.payload ->> m.payload_key ~ '^-?[0-9]+(\.[0-9]+)?$'
+                THEN (s.payload ->> m.payload_key)::numeric * m.sign
+           END AS amount
+      FROM roster r
+      CROSS JOIN needed n
+      JOIN line_item m ON m.name = n.line_item
+      JOIN stmt s ON s.instrument_id = r.instrument_id
+                 AND s.statement_type = 'income_statement'
+                 AND (s.ttm_slot IS NOT NULL OR s.prior_slot IS NOT NULL)
+),
+windows AS (
+    SELECT instrument_id, input_name,
+           count(*) FILTER (WHERE in_ttm) AS trailing_quarters,
+           count(*) FILTER (WHERE NOT in_ttm) AS prior_quarters,
+           sum(amount) FILTER (WHERE in_ttm) AS trailing_sum,
+           sum(amount) FILTER (WHERE NOT in_ttm) AS prior_sum,
+           bool_or(amount IS NULL) AS absent,
+           max(fiscal_period_end) AS as_of,
+           max(observed_on) AS known_on,
+           jsonb_agg(period ORDER BY fiscal_period_end DESC) AS periods
+      FROM used
+     GROUP BY instrument_id, input_name
+),
+found AS (
+    -- Every quarterly income statement held on or before the classification date.
+    SELECT instrument_id,
+           jsonb_agg(jsonb_build_object('statement_type', statement_type,
+                                        'fiscal_period_end', fiscal_period_end)
+                     ORDER BY fiscal_period_end DESC) AS periods_found
+      FROM stmt
+     WHERE statement_type = 'income_statement'
+     GROUP BY instrument_id
+),
+decided AS (
+    -- Missing before outdated before not computable (DEC-0116 (1)); a bar is never read.
+    SELECT r.instrument_id, n.input_name, n.line_item, w.trailing_sum, w.prior_sum,
+           w.as_of, w.known_on, f.periods_found,
+           jsonb_build_object('periods', w.periods) AS base,
+           CASE WHEN n.line_item = ANY(%(unresolved)s::text[]) THEN %(unresolved_cause)s::text
+                -- either window short, or no row of either (w is NULL)
+                WHEN coalesce(w.trailing_quarters < 4 OR w.prior_quarters < 4, true)
+                THEN 'periods_missing'
+                WHEN w.absent THEN 'line_item_absent'
+           END AS missing_cause,
+           (%(classification_date)s::date
+               - make_interval(months => %(stale_months)s::integer))::date AS stale_before
+      FROM roster r
+      CROSS JOIN needed n
+      LEFT JOIN windows w ON w.instrument_id = r.instrument_id AND w.input_name = n.input_name
+      LEFT JOIN found f ON f.instrument_id = r.instrument_id
+),
+statused AS (
+    SELECT d.*,
+           CASE WHEN d.missing_cause IS NOT NULL THEN 'missing'
+                WHEN d.as_of < d.stale_before THEN 'outdated'
+                WHEN d.prior_sum <= 0 THEN 'not_computable'
+                ELSE 'present'
+           END AS status
+      FROM decided d
+)
+SELECT s.instrument_id,
+       'growth'::text,
+       s.input_name,
+       s.status,
+       CASE WHEN s.status = 'present' THEN s.trailing_sum / s.prior_sum - 1 END,
+       CASE WHEN s.status <> 'missing' THEN s.as_of END,
+       CASE WHEN s.status <> 'missing' THEN s.known_on END,
+       -- The constant false: CAP-002-E2-S6 turns the backfilled flags of detail.periods
+       -- into the mark (DEC-0056, DEC-0122).
+       false,
+       CASE s.status
+            WHEN 'missing' THEN jsonb_strip_nulls(jsonb_build_object(
+                'cause', s.missing_cause,
+                'line_items', CASE WHEN s.missing_cause IN (%(unresolved_cause)s::text,
+                                                            'line_item_absent')
+                                   THEN jsonb_build_array(s.line_item)
+                              END,
+                'periods_found', CASE WHEN s.missing_cause IN ('periods_missing',
+                                                               'line_item_absent')
+                                      THEN coalesce(s.periods_found, jsonb_build_array())
+                                 END))
+            WHEN 'outdated' THEN jsonb_set(
+                jsonb_set(s.base, ARRAY['cause'], to_jsonb('outdated'::text)),
+                ARRAY['outdated'],
+                jsonb_build_object('fundamentals',
+                                   jsonb_build_object('latest_period_end', s.as_of,
+                                                      'stale_before', s.stale_before)))
+            WHEN 'not_computable' THEN jsonb_set(
+                jsonb_set(s.base, ARRAY['cause'], to_jsonb('prior_year_base_not_positive'::text)),
+                ARRAY['prior_year_base'], to_jsonb(s.prior_sum))
+            ELSE s.base
+       END,
+       'fundamentals'::text
+  FROM statused s
diff --git a/src/factorflow/classification/sql/insert_inputs.sql b/src/factorflow/classification/sql/insert_inputs.sql
new file mode 100644
index 0000000..3c51519
--- /dev/null
+++ b/src/factorflow/classification/sql/insert_inputs.sql
@@ -0,0 +1,21 @@
+-- Append the named factors' rows of the temporary table inputs to factor_input
+-- (factor-engine design 2.3 step 5; DEC-0115). A missing input's detail gains the
+-- instrument's last acquisition outcome for the data type it lacks, so the evidence can
+-- say what the last download of it found (AC-12). Writes only factor_input.
+-- CAP-002-E2-S3; CAP-002-E2-S4 runs it again for momentum.
+INSERT INTO factor_input (set_id, instrument_id, factor, input_name, status, value, as_of,
+                          known_on, restated_possible, detail)
+SELECT %(set_id)s::uuid, i.instrument_id, i.factor, i.input_name, i.status, i.value, i.as_of,
+       i.known_on, i.restated_possible,
+       CASE WHEN a.instrument_id IS NULL THEN i.detail
+            ELSE jsonb_set(i.detail, ARRAY['last_acquisition'],
+                           jsonb_build_object('data_type', a.data_type,
+                                              'outcome', a.last_outcome,
+                                              'acquired_at', a.last_acquired_at))
+       END
+  FROM inputs i
+  LEFT JOIN acquisition_state a
+         ON i.status = 'missing'
+        AND a.instrument_id = i.instrument_id
+        AND a.data_type = i.missing_data_type
+ WHERE i.factor = ANY(%(factors)s::text[])
diff --git a/src/factorflow/classification/sql/statements.sql b/src/factorflow/classification/sql/statements.sql
new file mode 100644
index 0000000..1d0e42f
--- /dev/null
+++ b/src/factorflow/classification/sql/statements.sql
@@ -0,0 +1,60 @@
+-- The latest observation of every quarterly statement period of the active instruments
+-- on or before the classification date, with its backfill flag and its slot in the
+-- trailing-twelve-month and prior-year windows (factor-engine design 2.3 step 3 and 2.4;
+-- DEC-0055 (1), DEC-0056). The windows follow DEC-0221, which replaces design 2.4's
+-- 12-month span rule. Reads only. CAP-002-E2-S3.
+CREATE TEMP TABLE stmt ON COMMIT DROP AS
+WITH latest AS (
+    -- Annual rows are excluded before the latest observation is chosen, so an FY row
+    -- sharing a quarter's period end never displaces or joins that quarter.
+    SELECT DISTINCT ON (f.instrument_id, f.statement_type, f.fiscal_period_end)
+           f.instrument_id, f.statement_type, f.fiscal_period_end, f.payload,
+           f.observed_on, f.provider_filing_date
+      FROM fundamental_observation f
+     WHERE f.instrument_id = ANY(%(active_ids)s::bigint[])
+       AND f.statement_type IN ('balance_sheet', 'income_statement', 'cash_flow_statement')
+       AND f.fiscal_period <> 'FY'
+       AND f.fiscal_period_end <= %(classification_date)s::date
+     ORDER BY f.instrument_id, f.statement_type, f.fiscal_period_end,
+              f.observed_on DESC, f.recorded_at DESC
+),
+first_observed AS (
+    -- The day FactorFlow first observed any fundamental of the instrument: every row it
+    -- holds, of every statement type, period kind and version (DEC-0056).
+    SELECT f.instrument_id, min(f.observed_on) AS first_observed_on
+      FROM fundamental_observation f
+     WHERE f.instrument_id = ANY(%(active_ids)s::bigint[])
+     GROUP BY f.instrument_id
+),
+ranked AS (
+    SELECT l.instrument_id, l.statement_type, l.fiscal_period_end, l.payload, l.observed_on,
+           l.provider_filing_date,
+           coalesce(l.provider_filing_date < o.first_observed_on, false) AS backfilled,
+           row_number() OVER newest_first AS period_rank,
+           -- Consecutive with the next older period: at most 4 months before it (DEC-0221).
+           lead(l.fiscal_period_end) OVER newest_first
+               >= l.fiscal_period_end - interval '4 months' AS consecutive
+      FROM latest l
+      JOIN first_observed o USING (instrument_id)
+    WINDOW newest_first AS (PARTITION BY l.instrument_id, l.statement_type
+                            ORDER BY l.fiscal_period_end DESC)
+),
+windows AS (
+    -- The trailing window P1 to P4 is formed when its three adjacent pairs are
+    -- consecutive; the prior-year window P5 to P8 when all seven pairs of P1 to P8 are
+    -- (DEC-0221, DEC-0055 (1)). Too few periods leave a pair without an older end.
+    SELECT instrument_id, statement_type,
+           count(*) FILTER (WHERE period_rank <= 3 AND consecutive) = 3 AS trailing_formed,
+           count(*) FILTER (WHERE period_rank <= 7 AND consecutive) = 7 AS prior_formed
+      FROM ranked
+     GROUP BY instrument_id, statement_type
+)
+-- A window that is not formed gives none of its rows a slot, and the inputs read it as
+-- missing.
+SELECT r.instrument_id, r.statement_type, r.fiscal_period_end, r.payload, r.observed_on,
+       r.provider_filing_date, r.backfilled, r.period_rank,
+       CASE WHEN w.trailing_formed AND r.period_rank <= 4 THEN r.period_rank END AS ttm_slot,
+       CASE WHEN w.prior_formed AND r.period_rank BETWEEN 5 AND 8
+            THEN r.period_rank - 4 END AS prior_slot
+  FROM ranked r
+  JOIN windows w USING (instrument_id, statement_type)
diff --git a/src/factorflow/classification/sql/value_inputs.sql b/src/factorflow/classification/sql/value_inputs.sql
new file mode 100644
index 0000000..9de900d
--- /dev/null
+++ b/src/factorflow/classification/sql/value_inputs.sql
@@ -0,0 +1,198 @@
+-- book_to_price, earnings_yield and fcf_yield for every active instrument (factor-engine
+-- design 2.4; DEC-0055 (1), (5), (6), (7); DEC-0116). Creates the temporary table inputs,
+-- which growth_inputs.sql and CAP-002-E2-S4's momentum_inputs.sql insert into (DEC-0115).
+-- Reads only. CAP-002-E2-S3.
+CREATE TEMP TABLE inputs ON COMMIT DROP AS
+WITH roster AS (
+    SELECT unnest(%(active_ids)s::bigint[]) AS instrument_id
+),
+line_item AS (
+    -- The seven line items with their bound payload keys and signs. A NULL key is one the
+    -- owner has not supplied yet (line_items.REQUIRES_INPUT).
+    SELECT m.name, m.statement_type, m.payload_key, m.sign
+      FROM unnest(%(line_item_names)s::text[], %(line_item_statement_types)s::text[],
+                  %(line_item_keys)s::text[], %(line_item_signs)s::integer[])
+           AS m (name, statement_type, payload_key, sign)
+),
+needed (input_name, line_items, window_type) AS (
+    -- The line items each input reads and the statement type of its trailing window.
+    -- Market capitalisation needs shares outstanding for every input.
+    VALUES ('book_to_price', ARRAY['book_equity', 'shares_outstanding'], NULL::text),
+           ('earnings_yield', ARRAY['net_income', 'shares_outstanding'], 'income_statement'),
+           ('fcf_yield', ARRAY['operating_cash_flow', 'capital_expenditure',
+                               'shares_outstanding'], 'cash_flow_statement')
+),
+used AS (
+    -- The rows an input reads: the most recent quarterly balance sheet and the four
+    -- quarters of its trailing window.
+    SELECT r.instrument_id, n.input_name, s.statement_type, s.fiscal_period_end,
+           s.observed_on, s.period_rank, s.payload,
+           jsonb_build_object('statement_type', s.statement_type,
+                              'fiscal_period_end', s.fiscal_period_end,
+                              'observed_on', s.observed_on,
+                              'provider_filing_date', s.provider_filing_date,
+                              'backfilled', s.backfilled) AS period
+      FROM roster r
+      CROSS JOIN needed n
+      JOIN stmt s ON s.instrument_id = r.instrument_id
+     WHERE (s.statement_type = 'balance_sheet' AND s.period_rank = 1)
+        OR (s.statement_type = n.window_type AND s.ttm_slot IS NOT NULL)
+),
+amount AS (
+    -- Each needed line item of each row used, times its sign. A value is read only from a
+    -- JSON number or a JSON string holding a plain decimal, checked before the cast, so
+    -- anything else reads as absent rather than failing the set (DEC-0116 (4),
+    -- DEC-0117 (2)).
+    SELECT u.instrument_id, u.input_name, m.name,
+           CASE WHEN jsonb_typeof(u.payload -> m.payload_key) IN ('number', 'string')
+                 AND u.payload ->> m.payload_key ~ '^-?[0-9]+(\.[0-9]+)?$'
+                THEN (u.payload ->> m.payload_key)::numeric * m.sign
+           END AS amount
+      FROM used u
+      JOIN needed n USING (input_name)
+      JOIN line_item m ON m.statement_type = u.statement_type AND m.name = ANY(n.line_items)
+),
+items AS (
+    SELECT instrument_id, input_name,
+           sum(amount) FILTER (WHERE name = 'book_equity') AS book_equity,
+           sum(amount) FILTER (WHERE name = 'shares_outstanding') AS shares_outstanding,
+           sum(amount) FILTER (WHERE name = 'net_income') AS net_income,
+           sum(amount) FILTER (WHERE name = 'operating_cash_flow') AS operating_cash_flow,
+           sum(amount) FILTER (WHERE name = 'capital_expenditure') AS capital_expenditure,
+           array_agg(DISTINCT name ORDER BY name) FILTER (WHERE amount IS NULL) AS absent
+      FROM amount
+     GROUP BY instrument_id, input_name
+),
+periods AS (
+    SELECT instrument_id, input_name,
+           count(*) FILTER (WHERE statement_type = 'balance_sheet') AS balance_sheets,
+           count(*) FILTER (WHERE statement_type <> 'balance_sheet') AS window_quarters,
+           max(fiscal_period_end) FILTER (WHERE statement_type = 'balance_sheet')
+               AS balance_sheet_period_end,
+           -- The earliest of the latest period ends used (DEC-0116 (3)).
+           min(fiscal_period_end) FILTER (WHERE period_rank = 1) AS as_of,
+           max(observed_on) AS known_on,
+           jsonb_agg(period ORDER BY statement_type, fiscal_period_end DESC) AS periods
+      FROM used
+     GROUP BY instrument_id, input_name
+),
+found AS (
+    -- Every quarterly period held of the statement types an input reads.
+    SELECT r.instrument_id, n.input_name,
+           jsonb_agg(jsonb_build_object('statement_type', s.statement_type,
+                                        'fiscal_period_end', s.fiscal_period_end)
+                     ORDER BY s.statement_type, s.fiscal_period_end DESC) AS periods_found
+      FROM roster r
+      CROSS JOIN needed n
+      JOIN stmt s ON s.instrument_id = r.instrument_id
+                 AND s.statement_type IN ('balance_sheet', n.window_type)
+     GROUP BY r.instrument_id, n.input_name
+),
+bar AS (
+    -- The latest bar: the latest session, then its latest observation (DEC-0055 (5), (6)).
+    SELECT r.instrument_id, b.session_date, b.close_price, b.observed_on
+      FROM roster r
+      CROSS JOIN LATERAL (
+          SELECT d.session_date, d.close_price, d.observed_on
+            FROM daily_bar d
+           WHERE d.instrument_id = r.instrument_id
+           ORDER BY d.session_date DESC, d.observed_on DESC, d.recorded_at DESC
+           LIMIT 1
+      ) b
+),
+judged AS (
+    SELECT r.instrument_id, n.input_name, n.window_type, p.balance_sheets, p.window_quarters,
+           p.as_of, p.periods, i.absent, f.periods_found, b.session_date AS bar_date,
+           -- DEC-0055 (7): the latest observation among the statement rows and the bar.
+           greatest(p.known_on, b.observed_on) AS known_on,
+           CASE n.input_name
+                WHEN 'book_to_price' THEN i.book_equity
+                WHEN 'earnings_yield' THEN i.net_income
+                WHEN 'fcf_yield' THEN i.operating_cash_flow - i.capital_expenditure
+           END AS numerator,
+           -- DEC-0055 (6): the latest close times the newest balance sheet's shares.
+           b.close_price * i.shares_outstanding AS market_capitalisation,
+           ARRAY(SELECT u.x FROM unnest(n.line_items) WITH ORDINALITY AS u (x, k)
+                  WHERE u.x = ANY(%(unresolved)s::text[]) ORDER BY u.k) AS unresolved,
+           (%(classification_date)s::date
+               - make_interval(months => %(stale_months)s::integer))::date AS stale_before,
+           jsonb_build_object('periods', p.periods,
+                              'balance_sheet_period_end', p.balance_sheet_period_end,
+                              'shares_outstanding', i.shares_outstanding,
+                              'close', b.close_price,
+                              'bar_date', b.session_date,
+                              'bar_observed_on', b.observed_on,
+                              'market_capitalisation', b.close_price * i.shares_outstanding)
+               AS base,
+           b.instrument_id IS NOT NULL AS has_bar
+      FROM roster r
+      CROSS JOIN needed n
+      LEFT JOIN periods p ON p.instrument_id = r.instrument_id AND p.input_name = n.input_name
+      LEFT JOIN items i ON i.instrument_id = r.instrument_id AND i.input_name = n.input_name
+      LEFT JOIN found f ON f.instrument_id = r.instrument_id AND f.input_name = n.input_name
+      LEFT JOIN bar b ON b.instrument_id = r.instrument_id
+),
+decided AS (
+    -- Missing before outdated before not computable (DEC-0116 (1), (2)).
+    SELECT j.*,
+           CASE WHEN cardinality(j.unresolved) > 0 THEN %(unresolved_cause)s::text
+                WHEN coalesce(j.balance_sheets, 0) = 0
+                  OR (j.window_type IS NOT NULL AND j.window_quarters = 0)
+                THEN 'periods_missing'
+                WHEN j.absent IS NOT NULL THEN 'line_item_absent'
+                WHEN NOT j.has_bar THEN 'price_missing'
+           END AS missing_cause,
+           j.as_of < j.stale_before AS fundamentals_outdated,
+           j.bar_date < %(latest_trading_day)s::date AS prices_outdated
+      FROM judged j
+),
+statused AS (
+    SELECT d.*,
+           CASE WHEN d.missing_cause IS NOT NULL THEN 'missing'
+                WHEN d.fundamentals_outdated OR d.prices_outdated THEN 'outdated'
+                WHEN d.market_capitalisation <= 0 THEN 'not_computable'
+                ELSE 'present'
+           END AS status
+      FROM decided d
+)
+SELECT s.instrument_id,
+       'value'::text AS factor,
+       s.input_name,
+       s.status,
+       CASE WHEN s.status = 'present' THEN s.numerator / s.market_capitalisation END AS value,
+       CASE WHEN s.status <> 'missing' THEN s.as_of END AS as_of,
+       CASE WHEN s.status <> 'missing' THEN s.known_on END AS known_on,
+       -- The constant false: CAP-002-E2-S6 turns the backfilled flags of detail.periods
+       -- into the mark (DEC-0056, DEC-0122).
+       false AS restated_possible,
+       CASE s.status
+            WHEN 'missing' THEN jsonb_strip_nulls(jsonb_build_object(
+                'cause', s.missing_cause,
+                'line_items', CASE s.missing_cause
+                                   WHEN %(unresolved_cause)s::text THEN to_jsonb(s.unresolved)
+                                   WHEN 'line_item_absent' THEN to_jsonb(s.absent)
+                              END,
+                'periods_found', CASE WHEN s.missing_cause IN ('periods_missing',
+                                                               'line_item_absent')
+                                      THEN coalesce(s.periods_found, jsonb_build_array())
+                                 END))
+            WHEN 'outdated' THEN jsonb_set(
+                jsonb_set(s.base, ARRAY['cause'], to_jsonb('outdated'::text)),
+                ARRAY['outdated'],
+                jsonb_strip_nulls(jsonb_build_object(
+                    'fundamentals', CASE WHEN s.fundamentals_outdated
+                                         THEN jsonb_build_object('latest_period_end', s.as_of,
+                                                                 'stale_before', s.stale_before)
+                                    END,
+                    'prices', CASE WHEN s.prices_outdated
+                                   THEN jsonb_build_object('bar_date', s.bar_date,
+                                                           'latest_trading_day',
+                                                           %(latest_trading_day)s::date)
+                              END)))
+            WHEN 'not_computable' THEN jsonb_set(
+                s.base, ARRAY['cause'], to_jsonb('market_capitalisation_not_positive'::text))
+            ELSE s.base
+       END AS detail,
+       CASE WHEN s.missing_cause = 'price_missing' THEN 'prices' ELSE 'fundamentals' END
+           AS missing_data_type
+  FROM statused s
diff --git a/tests/integration/engine_inputs_support.py b/tests/integration/engine_inputs_support.py
new file mode 100644
index 0000000..d8ccd9b
--- /dev/null
+++ b/tests/integration/engine_inputs_support.py
@@ -0,0 +1,217 @@
+"""Helpers for the factor engine's fundamentals-stage tests (CAP-002-E2-S3).
+
+A plain module rather than ``conftest.py``. It builds on CAP-002-E2-S2's
+``engine_support`` without editing it. The real Massive payload keys are the owner's
+open question (factor-engine design section 14 question 1), so the tests install their
+own keys (design section 7: "fixtures declare their own payload keys"). Every writing
+helper commits, so the build's connection sees what a test wrote.
+"""
+
+import calendar
+import hashlib
+import json
+from datetime import date, datetime, timedelta
+from decimal import Decimal
+from typing import Any
+from uuid import UUID
+
+import psycopg
+import pytest
+
+from factorflow.classification import engine, line_items
+from factorflow.classification.engine import BuildResult
+from factorflow.classification.line_items import LineItem
+from tests.integration.engine_support import (
+    add_bar,
+    add_building_set,
+    add_instrument,
+    add_run,
+    migrate_through_classification,
+)
+
+__all__ = [
+    "TEST_KEYS",
+    "add_bar",
+    "add_building_set",
+    "add_instrument",
+    "add_quarters",
+    "add_run",
+    "add_statement",
+    "install_test_line_items",
+    "inputs_for",
+    "migrate_through_classification",
+    "months_before",
+    "run_fundamentals_stage",
+]
+
+TEST_KEYS: dict[str, str] = {
+    "book_equity": "t_book_equity",
+    "shares_outstanding": "t_shares_outstanding",
+    "net_income": "t_net_income",
+    "diluted_eps": "t_diluted_eps",
+    "revenue": "t_revenue",
+    "operating_cash_flow": "t_operating_cash_flow",
+    "capital_expenditure": "t_capital_expenditure",
+}
+"""A test payload key per line item; never a real Massive key."""
+
+# Capital expenditure is reported as an outflow (negative) in the fixtures, so the
+# sign path of design 2.4 ``LineItem.sign`` is exercised.
+_TEST_SIGNS: dict[str, int] = {"capital_expenditure": -1}
+
+STATEMENT_TYPES = ("balance_sheet", "income_statement", "cash_flow_statement")
+
+
+def install_test_line_items(
+    monkeypatch: pytest.MonkeyPatch, overrides: dict[str, tuple[str, int]] | None = None
+) -> None:
+    """Replace every ``LINE_ITEMS`` entry with its test key; ``overrides`` sets (key, sign)."""
+    for name, item in line_items.LINE_ITEMS.items():
+        key, sign = TEST_KEYS[name], _TEST_SIGNS.get(name, 1)
+        if overrides and name in overrides:
+            key, sign = overrides[name]
+        monkeypatch.setitem(
+            line_items.LINE_ITEMS, name, LineItem(item.label, item.statement_type, key, sign)
+        )
+
+
+def months_before(day: date, months: int) -> date:
+    """``day`` minus whole calendar months, clamped to the month's last day."""
+    index = day.year * 12 + day.month - 1 - months
+    year, month = divmod(index, 12)
+    last = calendar.monthrange(year, month + 1)[1]
+    return date(year, month + 1, min(day.day, last))
+
+
+def _json_value(value: Any, numbers: bool) -> str:
+    if isinstance(value, Decimal):
+        # model_dump(mode="json") writes a Decimal as a JSON string (DEC-0117).
+        plain = format(value, "f")
+        return plain if numbers else json.dumps(plain)
+    return json.dumps(value)
+
+
+def _payload_text(payload: dict[str, Any], numbers: bool) -> str:
+    return (
+        "{"
+        + ", ".join(f"{json.dumps(k)}: {_json_value(v, numbers)}" for k, v in payload.items())
+        + "}"
+    )
+
+
+def add_statement(
+    conn: psycopg.Connection,
+    instrument_id: int,
+    period_end: date,
+    statement_type: str,
+    payload: dict[str, Any],
+    fiscal_period: str = "Q1",
+    observed_on: date | None = None,
+    provider_filing_date: date | None = None,
+    *,
+    numbers: bool = False,
+    recorded_at: datetime | None = None,
+) -> None:
+    """One ``fundamental_observation`` row; ``payload`` maps payload keys to values.
+
+    ``observed_on`` defaults to 15 days after the period end. A ``Decimal`` value is
+    written as a JSON string holding its plain decimal, or as a JSON number when
+    ``numbers`` is true; any other value is written as the JSON value given.
+    ``recorded_at`` defaults to the database's ``now()``.
+    """
+    observed = period_end + timedelta(days=15) if observed_on is None else observed_on
+    text = _payload_text(payload, numbers)
+    digest = hashlib.sha256(
+        json.dumps(
+            [
+                instrument_id,
+                str(period_end),
+                fiscal_period,
+                statement_type,
+                str(observed),
+                str(provider_filing_date),
+                text,
+                str(recorded_at),
+            ]
+        ).encode()
+    ).digest()
+    conn.execute(
+        "INSERT INTO fundamental_observation (instrument_id, fiscal_period_end, fiscal_period, "
+        "statement_type, observed_on, value_hash, provider_filing_date, payload, recorded_at) "
+        "VALUES (%s, %s, %s, %s, %s, %s, %s, %s::jsonb, coalesce(%s, now()))",
+        (
+            instrument_id,
+            period_end,
+            fiscal_period,
+            statement_type,
+            observed,
+            digest,
+            provider_filing_date,
+            text,
+            recorded_at,
+        ),
+    )
+    conn.commit()
+
+
+def add_quarters(
+    conn: psycopg.Connection,
+    instrument_id: int,
+    latest_period_end: date,
+    n: int,
+    values: list[dict[str, Any]],
+    *,
+    numbers: bool = False,
+) -> list[date]:
+    """``n`` quarterly period ends, 3 calendar months apart and newest first, each with a
+    balance sheet, an income statement and a cash-flow statement.
+
+    ``values[k]`` maps line-item names to the values of period ``k``; each item lands in
+    its own statement type under its test key, and an item omitted from a period's dict
+    is absent from that payload. Returns the period ends, newest first.
+    """
+    assert len(values) == n
+    ends = [months_before(latest_period_end, 3 * k) for k in range(n)]
+    for end, period in zip(ends, values, strict=True):
+        for statement_type in STATEMENT_TYPES:
+            payload = {
+                TEST_KEYS[name]: value
+                for name, value in period.items()
+                if line_items.LINE_ITEMS[name].statement_type == statement_type
+            }
+            add_statement(conn, instrument_id, end, statement_type, payload, numbers=numbers)
+    return ends
+
+
+def run_fundamentals_stage(
+    conn: psycopg.Connection, set_id: UUID, monkeypatch: pytest.MonkeyPatch
+) -> BuildResult:
+    """Build ``set_id`` with only this story's stage, so later stories' stages never run."""
+    monkeypatch.setattr(engine, "_STAGES", [engine._fundamental_inputs_stage])
+    return engine.build(conn, set_id, 60)
+
+
+def inputs_for(conn: psycopg.Connection, set_id: UUID, instrument_id: int) -> dict[str, dict]:
+    """The stock's ``factor_input`` rows of the set, by input name.
+
+    ``detail`` is parsed with ``Decimal`` for JSON numbers with a fraction, so numeric
+    components compare exactly.
+    """
+    rows = conn.execute(
+        "SELECT input_name, factor, status, value, as_of, known_on, restated_possible, "
+        "detail::text FROM factor_input WHERE set_id = %s AND instrument_id = %s",
+        (set_id, instrument_id),
+    ).fetchall()
+    conn.commit()
+    return {
+        row[0]: {
+            "factor": row[1],
+            "status": row[2],
+            "value": row[3],
+            "as_of": row[4],
+            "known_on": row[5],
+            "restated_possible": row[6],
+            "detail": json.loads(row[7], parse_float=Decimal),
+        }
+        for row in rows
+    }
diff --git a/tests/integration/test_engine_currency.py b/tests/integration/test_engine_currency.py
