    def test_equal_observed_on_is_decided_by_the_later_recorded_at(
        env: Env, monkeypatch: pytest.MonkeyPatch
    ) -> None:
        """Design 2.3 step 3: observed_on DESC, then recorded_at DESC (DAC-E2-9)."""
        _seven_older_quarters(env, P1)
        newest = standard()[0]
        for statement_type, names in (
            ("balance_sheet", ("book_equity", "shares_outstanding")),
            ("cash_flow_statement", ("operating_cash_flow", "capital_expenditure")),
        ):
            add_statement(
                env.conn, env.stock, P1, statement_type, {TEST_KEYS[n]: newest[n] for n in names}
            )
        seen = date(2026, 10, 15)
        late = datetime(2026, 10, 15, 18, tzinfo=UTC)
        # The later recording is inserted first, so neither insertion order nor heap order
        # can stand in for recorded_at.
        add_statement(
            env.conn,
            env.stock,
            P1,
            "income_statement",
            {TEST_KEYS["revenue"]: Decimal(150)},
            observed_on=seen,
            recorded_at=late,
        )
        add_statement(
            env.conn,
            env.stock,
            P1,
            "income_statement",
            {TEST_KEYS["revenue"]: Decimal(140)},
            observed_on=seen,
            recorded_at=late - timedelta(hours=6),
        )
    
