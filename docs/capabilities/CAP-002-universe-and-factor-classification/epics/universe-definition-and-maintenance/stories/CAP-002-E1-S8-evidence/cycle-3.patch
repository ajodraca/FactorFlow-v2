+  UniverseMember,
+} from "../../../../api/classification-types";
+import { ROW_HEIGHT_PX } from "../../results-window";
+import { MembersTab, type MembersTabProps } from "./members-tab";
+
+vi.mock("../../../../api/classification-client", async () => ({
+  ...(await vi.importActual<typeof import("../../../../api/classification-client")>(
+    "../../../../api/classification-client",
+  )),
+  getUniverse: vi.fn(),
+  listClassifications: vi.fn(),
+  removeUniverseMember: vi.fn(),
+  listUniverses: vi.fn(),
+}));
+
+const { ClassificationApiError } = classificationClient;
+const getUniverse = vi.mocked(classificationClient.getUniverse);
+const listClassifications = vi.mocked(classificationClient.listClassifications);
+const removeUniverseMember = vi.mocked(classificationClient.removeUniverseMember);
+const listUniverses = vi.mocked(classificationClient.listUniverses);
+
+const AS_OF_LINE = "Members as of 2026-09-30. Scores shown are from the current set.";
+const FILTERS_NOTE = "Filters and sorting apply to current members only.";
+const MALFORMED = "Enter a date as YYYY-MM-DD.";
+
+function scored(percentile: string): FactorCell {
+  return {
+    status: "classified",
+    score: "0.50",
+    percentile,
+    reasonCode: null,
+    reasonInput: null,
+    reasonDetail: null,
+    restatedPossible: false,
+  };
+}
+
+function notFollowed(): FactorCell {
+  return {
+    status: "not_classified",
+    score: null,
+    percentile: null,
+    reasonCode: "retired",
+    reasonInput: null,
+    reasonDetail: null,
+    restatedPossible: false,
+  };
+}
+
+function row(symbol: string, overrides: Partial<StockRow> = {}): StockRow {
+  return {
+    symbol,
+    name: `${symbol} Inc.`,
+    lifecycle: "active",
+    factors: { value: scored("88"), growth: scored("42"), momentum: scored("67") },
+    ...overrides,
+  };
+}
+
+const OLD = row("OLD", {
+  lifecycle: "retired",
+  factors: { value: notFollowed(), growth: notFollowed(), momentum: notFollowed() },
+});
+
+function list(stocks: StockRow[], matchCount = stocks.length): ClassificationList {
+  const summary = { qualifiedCount: 120, ranked: true, minPeerSetSize: 30 };
+  return {
+    neverClassified: false,
+    set: null,
+    later: null,
+    factors: { value: summary, growth: summary, momentum: summary },
+    matchCount,
+    stocks,
+    unknownSymbols: [],
+    nextCursor: null,
+  };
+}
+
+function member(symbol: string, overrides: Partial<UniverseMember> = {}): UniverseMember {
+  return {
+    symbol,
+    name: `${symbol} Inc.`,
+    lifecycle: "active",
+    memberSince: "2026-10-16T15:00:00Z",
+    factors: { value: scored("88"), growth: scored("42"), momentum: scored("67") },
+    ...overrides,
+  };
+}
+
+function universe(
+  members: UniverseMember[],
+  overrides: Partial<UniverseDetail> = {},
+): UniverseDetail {
+  return {
+    universeId: "u-tech",
+    name: "Tech",
+    lifecycle: "active",
+    createdAt: "2026-10-15T14:20:00Z",
+    retiredAt: null,
+    memberCount: members.length,
+    asOf: "2026-10-20",
+    asOfBeforeCreation: false,
+    origin: {
+      kind: "by_hand",
+      setId: null,
+      classificationDate: null,
+      thresholds: null,
+      hideIncomplete: null,
+      symbol: null,
+    },
+    members,
+    set: null,
+    ...overrides,
+  };
+}
+
+function apiError(code: string, operation: "get-universe" | "remove-universe-member") {
+  return new ClassificationApiError("never shown", "req-1", {
+    code,
+    operation,
+    resource: operation === "get-universe" ? "universe" : "universe-member",
+  });
+}
+
+function props(overrides: Partial<MembersTabProps> = {}): MembersTabProps {
+  return {
+    universeId: "u-tech",
+    universeName: "Tech",
+    lifecycle: "active",
+    memberCount: 3,
+    asOf: null,
+    onAsOfChange: vi.fn(),
+    onMembershipChanged: vi.fn(),
+    onRetire: vi.fn(),
+    ...overrides,
+  };
+}
+
+/** Prints the URL search, so a test can see what the tab writes there. */
+function LocationProbe() {
+  return <p data-testid="location">{useLocation().search}</p>;
+}
+
+function renderTab(tabProps: MembersTabProps, initialEntry = "/research/universes/u-tech") {
+  const view = render(
+    <MemoryRouter initialEntries={[initialEntry]}>
+      <MembersTab {...tabProps} />
+      <LocationProbe />
+    </MemoryRouter>,
+  );
+  return {
+    ...view,
+    rerenderTab: (next: MembersTabProps) =>
+      view.rerender(
+        <MemoryRouter initialEntries={[initialEntry]}>
+          <MembersTab {...next} />
+          <LocationProbe />
+        </MemoryRouter>,
+      ),
+  };
+}
+
+function statusWith(text: string): HTMLElement | undefined {
+  return screen.queryAllByRole("status").find((element) => element.textContent?.includes(text));
+}
+
+function results(): HTMLElement {
+  return screen.getByRole("region", { name: "Results" });
+}
+
+function memberRows(): HTMLElement[] {
+  return within(results())
+    .getAllByRole("row")
+    .filter((element) => element.querySelector('th[scope="row"]') !== null);
+}
+
+function rowFor(symbol: string): HTMLElement {
+  const found = memberRows().find(
+    (element) => element.querySelector('th[scope="row"]')?.textContent === symbol,
+  );
+  if (found === undefined) {
+    throw new Error(`no row for ${symbol}`);
+  }
+  return found;
+}
