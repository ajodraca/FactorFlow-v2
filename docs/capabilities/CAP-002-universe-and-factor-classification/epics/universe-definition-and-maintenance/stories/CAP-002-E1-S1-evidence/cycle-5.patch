     return uncovered
 
 
@@ -50,3 +60,26 @@ def test_guard_reports_a_sql_directory_no_glob_covers(tmp_path: Path) -> None:
 
     assert uncovered_sql_files(tmp_path, ["db/migrations/*.sql"]) == ["widgets/sql/read.sql"]
