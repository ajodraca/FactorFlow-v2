+++        service.create_by_hand(conn, "Value", ["AAA"])
+++    conn.rollback()
+++
+++    reused = service.create_by_hand(conn, "Growth", ["AAA"])
+++    conn.commit()
+++    assert reused.universe_id != first.universe_id
