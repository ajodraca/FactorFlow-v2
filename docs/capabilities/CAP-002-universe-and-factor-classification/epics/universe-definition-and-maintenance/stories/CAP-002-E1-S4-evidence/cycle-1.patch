+# --- TC-COMP-038 (rename and retire half): a retired universe refuses writes ----------
+
+
+def test_a_retired_universe_refuses_a_rename(conn: psycopg.Connection) -> None:
+    """Part of TC-COMP-038; the other writes are tested with remove_member."""
+    seed(conn, "AAA")
+    uid = _create(conn, "U", "AAA")
+    service.retire(conn, uid)
+    conn.commit()
+    before = count_events(conn)
+
+    with pytest.raises(UniverseRetired):
+        service.rename(conn, uid, "Other")
+    conn.rollback()
+    with pytest.raises(UniverseRetired):
+        service.retire(conn, uid)
+    conn.rollback()
+
+    assert count_events(conn) == before
+
