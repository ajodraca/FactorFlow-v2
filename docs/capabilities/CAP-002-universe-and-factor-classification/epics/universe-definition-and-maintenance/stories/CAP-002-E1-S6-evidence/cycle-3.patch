+@pytest.mark.parametrize(
+    ("extra", "field_name"),
+    [
+        ({"symbols": ["AAA"], "filter": {}, "set_id": "SET"}, "filter"),
+        ({}, "filter"),
+        ({"filter": {}}, "set_id"),
+    ],
+)
+def test_a_malformed_source_is_a_validation_error(
+    client: TestClient, conn: psycopg.Connection, extra: dict[str, Any], field_name: str
+) -> None:
+    set_id, _ = seed_classified(conn)
+    if extra.get("set_id") == "SET":
+        extra = {**extra, "set_id": str(set_id)}
+    before = written(conn)
+
+    response = client.post("/api/universes", json={"name": "Bad", **extra})
+
+    error = refusal(response, 422, "validation_error")
+    assert f"`{field_name}`" in error["message"]
+    assert written(conn) == before
+
+
+def test_an_unknown_set_id_is_classification_set_changed(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    seed_classified(conn)
+
+    refusal(save_filter(client, uuid4(), {}), 409, "classification_set_changed")
+    assert written(conn) == (0, 0)
