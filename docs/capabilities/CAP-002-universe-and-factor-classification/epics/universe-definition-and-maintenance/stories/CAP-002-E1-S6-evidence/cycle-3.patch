+def test_a_newer_complete_set_refuses_the_save(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    old, ids = seed_classified(conn)
+    newer = seed_set(
+        conn, classification_date=SET_DATE + timedelta(days=1), ended_at=T0 + timedelta(days=1)
+    )
+    for symbol, cells in BASE.items():
+        classify(conn, newer, ids[symbol], cells)
+    before = written(conn)
+
+    error = refusal(save_filter(client, old, {}), 409, "classification_set_changed")
+
+    assert str(old) in error["message"] and str(newer) in error["message"]
+    assert written(conn) == before
+
+
+def test_a_filter_matching_nothing_is_empty_universe(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    set_id, _ = seed_classified(conn)
+    before = written(conn)
+
+    error = refusal(save_filter(client, set_id, {"value_score_min": "100"}), 422, "empty_universe")
+
+    assert "filter" in error["message"]
+    assert written(conn) == before
+
