+# --- T011: the lifecycle flows -----------------------------------------------------------
+
+
+def test_create_by_hand_returns_and_reads_the_replayed_universe(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    seed(conn, "AAA", "BBB")
+
+    created = create(client, " Mine ", "bbb", "AAA")
+
+    assert created["name"] == "Mine"
+    assert created["lifecycle"] == "active"
+    assert created["origin"]["kind"] == "by_hand"
+    assert [m["symbol"] for m in created["members"]] == ["AAA", "BBB"]
+    assert created["member_count"] == 2
+    assert created["set"] is None  # no classification set yet
+    read = client.get(f"/api/universes/{created['universe_id']}").json()
+    assert read == created
+    for member in read["members"]:
+        assert member["name"] is None
+        assert member["factors"] is None
+    events = all_events(client, created["universe_id"])
+    assert events[-1]["event_type"] == "created"
+    assert events[-1]["filter_provenance"] is None
+
+
+def test_names_are_unique_among_active_universes_after_trimming(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    seed(conn, "AAA")
+    first = create(client, "Tech", "AAA")
+    other = create(client, "Other", "AAA")
+
+    response = client.post("/api/universes", json={"name": "  Tech\t", "symbols": ["AAA"]})
+    error = refusal(response, 409, "universe_name_in_use")
+    assert "Tech" in error["message"]
+    patched = client.patch(f"/api/universes/{other['universe_id']}", json={"name": "Tech "})
+    refusal(patched, 409, "universe_name_in_use")
+
+    assert client.delete(f"/api/universes/{first['universe_id']}").status_code == 200
+    assert create(client, "Tech", "AAA")["name"] == "Tech"
