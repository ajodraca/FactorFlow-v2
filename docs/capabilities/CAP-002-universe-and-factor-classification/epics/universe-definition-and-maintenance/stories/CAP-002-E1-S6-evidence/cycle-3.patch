+def test_events_page_newest_first_and_refuse_a_tampered_cursor(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    seed(conn, "AAA", "BBB", "CCC")
+    universe_id = create(client, "Mine", "AAA", "BBB", "CCC")["universe_id"]
+    every = all_events(client, universe_id)
+    assert len(every) == 4
+
+    first = client.get(f"/api/universes/{universe_id}/events", params={"limit": 2}).json()
+    second = client.get(
+        f"/api/universes/{universe_id}/events", params={"limit": 2, "cursor": first["next_cursor"]}
+    ).json()
+    assert first["events"] + second["events"] == every
+    assert [e["event_id"] for e in every] == sorted((e["event_id"] for e in every), reverse=True)
+    assert second["next_cursor"] is None
