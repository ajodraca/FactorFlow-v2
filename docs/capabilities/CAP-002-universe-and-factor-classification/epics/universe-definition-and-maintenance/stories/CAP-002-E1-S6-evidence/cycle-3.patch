+"""The universes router against PostgreSQL (CAP-002-E1-S6; task plan T003, T005, T008, T011, T012).
+
+The app is built by `create_app()` against a store migrated through every migration, so the
+real pool, service, replay and reader run behind the real middleware. Rows are seeded with
+the S3 and S5 test helpers on a separate autocommit connection, which also reads the results
+back. Instrument names come from `instrument_reference` (DEC-0245), the reader's only source.
+"""
+
+from collections.abc import Iterator
+from datetime import date, datetime, timedelta
+from decimal import Decimal
+from typing import Any
+from uuid import UUID, uuid4
+from zoneinfo import ZoneInfo
+
+import psycopg
+import pytest
+from fastapi.testclient import TestClient
+
+from factorflow.api.app import create_app
+from factorflow.classification import reader
+from factorflow.classification.reader import Thresholds
+from factorflow.db.migrate_main import MIGRATIONS_DIR
+from factorflow.db.migrator import apply_pending, discover
+from tests.integration.reader_seed import insert_reference
+from tests.integration.test_universe_create import count_events, seed_instrument
+from tests.integration.test_universe_filter_snapshot import BASE, SET_DATE, T0, classify, seed_set
+
+pytestmark = pytest.mark.postgres
+
+
+@pytest.fixture
+def database(postgres_connection_string: str) -> str:
+    connection = psycopg.connect(postgres_connection_string)
+    try:
+        apply_pending(connection, discover(MIGRATIONS_DIR))
+        connection.commit()
+    finally:
+        connection.close()
+    return postgres_connection_string
+
+
+@pytest.fixture
+def conn(database: str) -> Iterator[psycopg.Connection]:
+    connection = psycopg.connect(database, autocommit=True)
+    try:
+        yield connection
+    finally:
+        connection.close()
+
+
+@pytest.fixture
+def client(database: str, monkeypatch: pytest.MonkeyPatch) -> Iterator[TestClient]:
+    monkeypatch.setenv("FACTORFLOW_DATABASE_URL", database)
+    with TestClient(create_app(), base_url="http://127.0.0.1:8000") as test_client:
+        yield test_client
+
+
+def count_universes(conn: psycopg.Connection) -> int:
+    row = conn.execute("SELECT count(*) FROM universe").fetchone()
+    assert row is not None
+    return int(row[0])
+
+
+def written(conn: psycopg.Connection) -> tuple[int, int]:
+    return count_universes(conn), count_events(conn)
+
+
+def seed(conn: psycopg.Connection, *symbols: str) -> None:
+    for symbol in symbols:
+        seed_instrument(conn, symbol)
+
+
+def create(client: TestClient, name: str, *symbols: str) -> dict[str, Any]:
+    response = client.post("/api/universes", json={"name": name, "symbols": list(symbols)})
+    assert response.status_code == 201, response.text
+    body: dict[str, Any] = response.json()
+    return body
+
+
+def all_events(client: TestClient, universe_id: str) -> list[dict[str, Any]]:
+    events: list[dict[str, Any]] = []
+    cursor: str | None = None
+    while True:
+        params = {"limit": 500} if cursor is None else {"limit": 500, "cursor": cursor}
+        body = client.get(f"/api/universes/{universe_id}/events", params=params).json()
+        events += body["events"]
+        cursor = body["next_cursor"]
+        if cursor is None:
+            return events
+
+
+def refusal(response: Any, status: int, code: str) -> dict[str, Any]:
+    assert response.status_code == status, response.text
+    error: dict[str, Any] = response.json()["error"]
+    assert error["code"] == code
+    assert error["message"]
+    assert error["resource"]
+    assert error["request_id"] == response.headers["X-Request-Id"]
+    assert "Traceback" not in response.text
+    return error
+
+
+def today() -> date:
+    return datetime.now(ZoneInfo("America/Chicago")).date()
+
+
+# --- TC-COMP-004 ------------------------------------------------------------------------
+
+
+# Implements TC-COMP-004
+def test_create_naming_uncovered_symbols_is_refused_whole(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    seed(conn, "AAA", "CCC")
+    seed_instrument(conn, "BBB", covered=False)
+
+    response = client.post(
+        "/api/universes", json={"name": "Mine", "symbols": ["aaa", "zzz", "bbb", "ccc"]}
+    )
+
+    error = refusal(response, 409, "instrument_not_acquired")
+    assert error["resource"] == "universe"
+    assert error["symbols"] == ["BBB", "ZZZ"]
+    assert "create a universe" in error["message"]
+    assert "BBB" in error["message"] and "ZZZ" in error["message"]
+    assert "AAA" not in error["message"] and "CCC" not in error["message"]
+    assert written(conn) == (0, 0)
+
+
+# --- TC-COMP-027 ------------------------------------------------------------------------
+
+
+# Implements TC-COMP-027
+def test_adding_a_current_member_reports_already_member_and_appends_no_event(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    seed(conn, "AAA", "CCC")
+    universe = create(client, "Mine", "AAA")
+    before = count_events(conn)
+
+    response = client.post(
+        f"/api/universes/{universe['universe_id']}/members", json={"symbols": ["aaa", "CCC"]}
+    )
+
+    assert response.status_code == 200
+    assert response.json() == {"added": ["CCC"], "already_member": ["AAA"]}
+    assert count_events(conn) == before + 1
+    newest = all_events(client, universe["universe_id"])[0]
+    assert (newest["event_type"], newest["symbol"]) == ("member_added", "CCC")
+
+    again = client.post(
+        f"/api/universes/{universe['universe_id']}/members", json={"symbols": ["CCC", "AAA"]}
+    )
+    assert again.status_code == 200
+    assert again.json() == {"added": [], "already_member": ["AAA", "CCC"]}
+    assert count_events(conn) == before + 1
+
+
+# --- TC-COMP-041 ------------------------------------------------------------------------
+
+
+# Implements TC-COMP-041
+def test_removing_the_sole_member_is_refused_then_retired_refuses_writes(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    seed(conn, "AAA")
+    universe_id = create(client, "Solo", "AAA")["universe_id"]
+    before = count_events(conn)
+
+    error = refusal(client.delete(f"/api/universes/{universe_id}/members/aaa"), 409, "last_member")
+    assert error["resource"] == "universe-member"
+    assert "AAA" in error["message"]
+    assert "retire" in error["message"]
+    assert count_events(conn) == before
+    members = client.get(f"/api/universes/{universe_id}").json()["members"]
+    assert [m["symbol"] for m in members] == ["AAA"]
+
+    assert client.delete(f"/api/universes/{universe_id}").status_code == 200
+    refusal(client.delete(f"/api/universes/{universe_id}/members/AAA"), 409, "universe_retired")
+
