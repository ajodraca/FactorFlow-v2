+# --- T012: the filter path ----------------------------------------------------------------
+
+
+NAMES = {symbol: f"{symbol} Holdings" for symbol in BASE}
+
+
+def seed_classified(conn: psycopg.Connection, **set_kwargs: Any) -> tuple[UUID, dict[str, int]]:
+    """One complete set over the S5 `BASE` stocks, each with a reference name."""
+    set_id = seed_set(conn, **set_kwargs)
+    ids: dict[str, int] = {}
+    for symbol, cells in BASE.items():
+        ids[symbol] = seed_instrument(conn, symbol)
+        classify(conn, set_id, ids[symbol], cells)
+        insert_reference(conn, ids[symbol], NAMES[symbol])
+    return set_id, ids
+
+
+def oracle(conn: psycopg.Connection, set_id: UUID, thresholds: Thresholds) -> list[str]:
+    instrument_ids = reader.evaluate_filter(conn, set_id, thresholds)
+    rows = conn.execute(
+        "SELECT symbol FROM instrument WHERE instrument_id = ANY(%s) ORDER BY symbol",
+        (instrument_ids,),
+    ).fetchall()
+    return [row[0] for row in rows]
+
+
+def save_filter(
+    client: TestClient, set_id: UUID, filter_body: dict[str, Any], name: str = "Saved"
+) -> Any:
+    return client.post(
+        "/api/universes", json={"name": name, "filter": filter_body, "set_id": str(set_id)}
+    )
+
+
+def test_create_from_a_result_saves_the_filter_match_with_provenance(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    set_id, _ = seed_classified(conn)
+
+    response = save_filter(client, set_id, {"value_percentile_min": "80"})
+
+    assert response.status_code == 201, response.text
+    body = response.json()
+    expected = oracle(conn, set_id, Thresholds(bounds={"value_percentile_min": Decimal("80")}))
+    assert expected  # the seed matches several stocks
+    assert [m["symbol"] for m in body["members"]] == expected
+    assert body["origin"] == {
+        "kind": "from_filter",
+        "set_id": str(set_id),
+        "classification_date": SET_DATE.isoformat(),
+        "thresholds": {"value_percentile_min": "80"},
+        "hide_incomplete": False,
+        "symbol": None,
+    }
+    assert body["set"]["set_id"] == str(set_id)
+    read = client.get(f"/api/universes/{body['universe_id']}").json()
+    for member in read["members"]:
+        assert member["name"] == NAMES[member["symbol"]]
+        assert member["factors"] is not None
+        assert set(member["factors"]) == {"value", "growth", "momentum"}
+
+    events = all_events(client, body["universe_id"])
+    row = conn.execute(
+        "SELECT filter_provenance FROM universe_event "
+        "WHERE universe_id = %(id)s AND event_type = 'created'",
+        {"id": body["universe_id"]},
+    ).fetchone()
+    assert row is not None
+    assert set(row[0]) == {
+        "set_id",
+        "classification_date",
+        "thresholds",
+        "hide_incomplete",
+        "symbol",
+    }
+    assert events[-1]["event_type"] == "created"
+    assert events[-1]["filter_provenance"] == row[0]
+    assert all(e["filter_provenance"] is None for e in events[:-1])
+    assert {e["event_type"] for e in events[:-1]} == {"member_added"}
+
+
+def test_hide_incomplete_saves_only_complete_stocks(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    set_id, _ = seed_classified(conn)
+
+    body = save_filter(client, set_id, {"hide_incomplete": True}).json()
+
+    symbols = [m["symbol"] for m in body["members"]]
+    assert symbols == oracle(conn, set_id, Thresholds(hide_incomplete=True))
+    assert "AAC" not in symbols  # its growth input is missing
+    assert body["origin"]["hide_incomplete"] is True
+
