+def test_the_list_filters_counts_and_pages(client: TestClient, conn: psycopg.Connection) -> None:
+    seed(conn, "AAA")
+    ids = [create(client, f"U{n}", "AAA")["universe_id"] for n in range(1, 4)]
+    assert client.delete(f"/api/universes/{ids[0]}").status_code == 200
+
+    active = client.get("/api/universes").json()
+    assert [u["universe_id"] for u in active["universes"]] == [ids[2], ids[1]]
+    assert (active["active_count"], active["retired_count"]) == (2, 1)
+    assert all(u["member_count"] == 1 for u in active["universes"])
+    retired = client.get("/api/universes", params={"lifecycle": "retired"}).json()
+    assert [u["universe_id"] for u in retired["universes"]] == [ids[0]]
+    everything = client.get("/api/universes", params={"lifecycle": "all"}).json()
+    assert [u["universe_id"] for u in everything["universes"]] == ids[::-1]
+    named = client.get("/api/universes", params={"lifecycle": "all", "name": "U2"}).json()
+    assert [u["universe_id"] for u in named["universes"]] == [ids[1]]
+
+    paged: list[str] = []
+    cursor: str | None = None
+    while True:
+        params: dict[str, Any] = {"lifecycle": "all", "limit": 1}
+        if cursor is not None:
+            params["cursor"] = cursor
+        page = client.get("/api/universes", params=params).json()
+        assert len(page["universes"]) <= 1
+        paged += [u["universe_id"] for u in page["universes"]]
+        cursor = page["next_cursor"]
+        if cursor is None:
+            break
+    assert paged == ids[::-1]
