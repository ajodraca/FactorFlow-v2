+def test_a_symbol_prefix_is_upper_cased_and_saved(
+    client: TestClient, conn: psycopg.Connection
+) -> None:
+    set_id, _ = seed_classified(conn)
+
+    body = save_filter(client, set_id, {"symbol": "aa"}).json()
+
+    assert [m["symbol"] for m in body["members"]] == ["AAA", "AAB", "AAC"]
+    assert body["origin"]["symbol"] == "AA"
