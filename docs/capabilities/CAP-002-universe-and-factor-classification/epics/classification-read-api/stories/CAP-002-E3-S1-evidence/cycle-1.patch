index 0000000..04fc5da
--- /dev/null
+++ b/src/factorflow/classification/reader.py
@@ -0,0 +1,176 @@
+"""The classification read side: the current set, the later attempt and the summary.
+
+Implements ``component-design-classification-reader.md`` sections 2.1 (placement), 2.3
+(interface), 2.4 (current set, currency and the summary) and 7 (testing) for CAP-002-E3-S1.
+
+- The current set is the latest set in state ``complete``; ``later`` is the most recent set
+  started after it, or the most recent set while none is complete; ``not_current`` is true
+  exactly when ``later`` is not None (AC-20, AC-21; DAC-E3-1; DAC-E3-S1-1, DAC-E3-S1-2).
+- Before any set is complete the reads carry ``never_classified`` with ``set`` None, in the same
+  shape as every other state (AC-22; DAC-E3-11; DAC-E3-S1-3).
+- A stock is current when none of its ``factor_input`` rows in the current set is ``missing`` or
+  ``outdated``; ``not_computable`` does not count against currency. The summary carries counts
+  only, never a stock row (AC-13; DAC-E3-10; DAC-E3-S1-4, DAC-E3-S1-5).
+- Every value returned is a stored row; nothing is recomputed here (STD-UI-15; DAC-E3-S1-6).
+
+``read_set_blocks`` is the one definition of the ``set`` and ``later`` blocks that the summary,
+the list read and the API reuse (task plan Open Gap 3; SA-DUP-001). Statements are ``.sql`` files
+under ``sql/``, loaded at import and executed with bound parameters only. The reader takes the
+caller's connection, writes nothing and never commits; database errors propagate (OPS-ERR-001).
+"""
+
+from dataclasses import dataclass
+from datetime import date, datetime
+from pathlib import Path
+from typing import Any, Final
+from uuid import UUID
+
+import psycopg
+
+from factorflow.classification.constants import FACTORS, MIN_PEER_SET_SIZE
+
+__all__ = [
+    "CURRENT_SET_SQL",
+    "FACTORS",
+    "MIN_PEER_SET_SIZE",
+    "SUMMARY_SQL",
+    "CurrentSet",
+    "FactorSummary",
+    "LaterSet",
+    "StocksCurrent",
+    "Summary",
+    "current_set",
+    "read_set_blocks",
+    "summary",
+]
+
+_SQL_DIR = Path(__file__).parent / "sql"
+CURRENT_SET_SQL: Final = (_SQL_DIR / "current_set.sql").read_text()
+SUMMARY_SQL: Final = (_SQL_DIR / "summary.sql").read_text()
+
+
+@dataclass(frozen=True)
+class LaterSet:
+    """The most recent set newer than the current one, or the most recent while none is complete;
+    one shape on the list and the summary (DEC-0082)."""
+
+    set_id: UUID
+    state: str  # building | failed
+    run_id: UUID
+    run_started_at: datetime  # acquisition_run.started_at (DEC-0083)
+    started_at: datetime
+    ended_at: datetime | None
+    failure_reason: str | None
+
+
+@dataclass(frozen=True)
+class FactorSummary:
+    qualified_count: int
+    ranked: bool
+    min_peer_set_size: int  # 30, AC-14
+
+
+@dataclass(frozen=True)
+class CurrentSet:
+    set_id: UUID
+    classification_date: date
+    run_id: UUID
+    run_started_at: datetime  # acquisition_run.started_at (DEC-0083)
+    run_outcome: str  # succeeded | partial, from acquisition_run.state
+    state: str  # complete
+    started_at: datetime
+    ended_at: datetime  # the as-of line's "Scores from {date} {time}"
+    latest_trading_day: date
+    active_instruments: int  # followed_count
+    factors: dict[str, FactorSummary]
+    not_current: bool  # true exactly when `later` is not None (DEC-0082)
+
+
+@dataclass(frozen=True)
+class StocksCurrent:
+    current_count: int  # stocks with no factor_input row missing or outdated (AC-12, AC-13)
+    followed_count: int  # the set's active_instruments
+
+
+@dataclass(frozen=True)
+class Summary:
+    set: CurrentSet | None  # the latest complete set, or None
+    never_classified: bool  # true exactly when set is None
+    later: LaterSet | None  # the newer building or failed set, or the latest while none is complete
+    stocks_current: StocksCurrent | None
+
+
+def read_set_blocks(conn: psycopg.Connection) -> tuple[CurrentSet | None, LaterSet | None]:
+    """The ``set`` and ``later`` blocks every classification read carries, from one statement."""
+    with conn.cursor() as cur:
+        cur.execute(CURRENT_SET_SQL)
+        row = cur.fetchone()
+        names = [column.name for column in cur.description] if cur.description else []
+    if row is None:
+        return None, None
+    columns = dict(zip(names, row, strict=True))
+    later = _row_to_later(columns) if columns["later_set_id"] is not None else None
+    current = (
+        _row_to_current(columns, not_current=later is not None)
+        if columns["set_id"] is not None
+        else None
+    )
+    return current, later
+
+
+def current_set(conn: psycopg.Connection) -> CurrentSet | None:
+    """The latest complete set, or None before any set is complete (AC-22)."""
+    return read_set_blocks(conn)[0]
+
+
+def summary(conn: psycopg.Connection) -> Summary:
+    """The current set with its ``later``, plus the current-stock count; no stock rows."""
+    current, later = read_set_blocks(conn)
+    if current is None:
+        return Summary(set=None, never_classified=True, later=later, stocks_current=None)
+    with conn.cursor() as cur:
+        cur.execute(SUMMARY_SQL, {"set_id": current.set_id})
+        row = cur.fetchone()
+    if row is None:  # an ungrouped aggregate always returns one row
+        raise RuntimeError("summary.sql returned no row")
+    stocks_current = StocksCurrent(
+        current_count=int(row[0]), followed_count=current.active_instruments
+    )
+    return Summary(set=current, never_classified=False, later=later, stocks_current=stocks_current)
+
+
+def _row_to_later(c: dict[str, Any]) -> LaterSet:
+    return LaterSet(
+        set_id=c["later_set_id"],
+        state=str(c["later_state"]),
+        run_id=c["later_run_id"],
+        run_started_at=c["later_run_started_at"],
+        started_at=c["later_started_at"],
+        ended_at=c["later_ended_at"],
+        failure_reason=c["later_failure_reason"],
+    )
+
+
+def _row_to_current(c: dict[str, Any], *, not_current: bool) -> CurrentSet:
+    stored = c["factors"]
+    return CurrentSet(
+        set_id=c["set_id"],
+        classification_date=c["classification_date"],
+        run_id=c["run_id"],
+        run_started_at=c["run_started_at"],
+        run_outcome=str(c["run_outcome"]),
+        state=str(c["state"]),
+        started_at=c["started_at"],
+        ended_at=c["ended_at"],
+        latest_trading_day=c["latest_trading_day"],
+        active_instruments=int(c["active_instruments"]),
+        factors={
+            f: FactorSummary(
+                qualified_count=int(stored[f]["qualified_count"]),
+                ranked=bool(stored[f]["ranked"]),
+                min_peer_set_size=MIN_PEER_SET_SIZE,
+            )
+            for f in FACTORS
+        },
+        not_current=not_current,
+    )
diff --git a/src/factorflow/classification/sql/current_set.sql b/src/factorflow/classification/sql/current_set.sql
new file mode 100644
index 0000000..951c6d0
--- /dev/null
+++ b/src/factorflow/classification/sql/current_set.sql
@@ -0,0 +1,41 @@
+-- The current set and the later attempt: component-design-classification-reader.md section 2.4.
+-- current: the latest complete set (constraint 11). later: the most recent set started after it,
+-- or the most recent set while none is complete (DEC-0082; task plan Open Gap 1). One row, or
+-- none when no set exists; the current columns are null when no set is complete.
+WITH current AS (
+    SELECT s.*, r.state AS run_outcome, r.started_at AS run_started_at
+      FROM classification_set s JOIN acquisition_run r USING (run_id)
+     WHERE s.state = 'complete'
+     ORDER BY s.ended_at DESC
+     LIMIT 1
+),
+later AS (
+    SELECT s.set_id, s.state, s.run_id, r.started_at AS run_started_at,
+           s.started_at, s.ended_at, s.failure_reason
+      FROM classification_set s JOIN acquisition_run r USING (run_id)
+     WHERE s.started_at > COALESCE((SELECT started_at FROM current), '-infinity')
+     ORDER BY s.started_at DESC
+     LIMIT 1
+)
+SELECT c.set_id,
+       c.classification_date,
+       c.run_id,
+       c.run_started_at,
+       c.run_outcome,
+       c.state,
+       c.started_at,
+       c.ended_at,
+       c.latest_trading_day,
+       c.active_instruments,
+       (SELECT jsonb_object_agg(f.factor, jsonb_build_object(
+                   'qualified_count', f.qualified_count, 'ranked', f.ranked))
+          FROM classification_set_factor f
+         WHERE f.set_id = c.set_id) AS factors,
+       l.set_id         AS later_set_id,
+       l.state          AS later_state,
+       l.run_id         AS later_run_id,
+       l.run_started_at AS later_run_started_at,
+       l.started_at     AS later_started_at,
+       l.ended_at       AS later_ended_at,
+       l.failure_reason AS later_failure_reason
+  FROM current c FULL JOIN later l ON true;
diff --git a/src/factorflow/classification/sql/summary.sql b/src/factorflow/classification/sql/summary.sql
new file mode 100644
index 0000000..a709390
--- /dev/null
+++ b/src/factorflow/classification/sql/summary.sql
@@ -0,0 +1,10 @@
+-- src/factorflow/classification/sql/summary.sql (run with the current set_id)
+SELECT count(*) FILTER (WHERE NOT stale) AS current_count,
+       count(*)                           AS scored_roster
+  FROM (
+    SELECT fi.instrument_id,
+           bool_or(fi.status IN ('missing', 'outdated')) AS stale
+      FROM factor_input fi
+     WHERE fi.set_id = %(set_id)s
+     GROUP BY fi.instrument_id
+  ) per_stock;
diff --git a/tests/integration/reader_seed.py b/tests/integration/reader_seed.py
new file mode 100644
index 0000000..705e222
--- /dev/null
+++ b/tests/integration/reader_seed.py
@@ -0,0 +1,128 @@
+"""Seed classification sets directly for the reader's database tests (CAP-002-E3-S1).
+
+A plain module rather than ``conftest.py``: ``tests/conftest.py`` is a delivered file.
+The reader is tested independently of the engine (``component-design-classification-reader.md``
+section 7), so these helpers write ``research-store`` rows straight into the tables, with
+bound parameters only, and commit so the reader's statements see them. Later E3 reader
+stories import and extend this module.
+"""
+
+from datetime import date, datetime
+from typing import Any
+from uuid import UUID
+
+import psycopg
+from psycopg.types.json import Jsonb
+
+from factorflow.classification.constants import FACTORS, INPUT_NAMES
+
+
+def insert_instrument(conn: psycopg.Connection, symbol: str, lifecycle: str = "active") -> int:
+    row = conn.execute(
+        "INSERT INTO instrument (symbol, lifecycle, retired_at) "
+        "VALUES (%s, %s, CASE WHEN %s = 'retired' THEN now() END) RETURNING instrument_id",
+        (symbol, lifecycle, lifecycle),
+    ).fetchone()
+    conn.commit()
+    assert row is not None
+    return int(row[0])
+
+
+def insert_run(conn: psycopg.Connection, state: str = "succeeded", *, started_at: datetime) -> UUID:
+    """An acquisition run; a terminal state gets an ``ended_at`` (terminal_has_end)."""
+    row = conn.execute(
+        "INSERT INTO acquisition_run (state, history_depth_years, started_at, ended_at) "
+        "VALUES (%s, 5, %s, CASE WHEN %s IN ('succeeded', 'partial', 'failed', 'cancelled', "
+        "'abandoned') THEN %s::timestamptz END) RETURNING run_id",
+        (state, started_at, state, started_at),
+    ).fetchone()
+    conn.commit()
+    assert row is not None
+    return row[0]  # type: ignore[no-any-return]
+
+
+def insert_set(
+    conn: psycopg.Connection,
+    run_id: UUID,
+    state: str,
+    *,
+    started_at: datetime,
+    ended_at: datetime | None = None,
+    classification_date: date = date(2026, 10, 15),
+    latest_trading_day: date | None = None,
+    active_instruments: int | None = None,
+    failure_reason: str | None = None,
+    factors: dict[str, tuple[int, bool]] | None = None,
+) -> UUID:
+    """A ``classification_set`` row and its three ``classification_set_factor`` rows.
+
+    ``factors`` maps a factor to ``(qualified_count, ranked)``; a factor it omits gets
+    ``(0, False)``. The caller supplies the values the set's CHECK constraints require.
+    """
+    row = conn.execute(
+        "INSERT INTO classification_set (run_id, state, classification_date, latest_trading_day, "
+        "active_instruments, started_at, ended_at, failure_reason) "
+        "VALUES (%s, %s, %s, %s, %s, %s, %s, %s) RETURNING set_id",
+        (
+            run_id,
+            state,
+            classification_date,
+            latest_trading_day,
+            active_instruments,
+            started_at,
+            ended_at,
+            failure_reason,
+        ),
+    ).fetchone()
+    assert row is not None
+    set_id: UUID = row[0]
+    given = factors or {}
+    for factor in FACTORS:
+        qualified_count, ranked = given.get(factor, (0, False))
+        conn.execute(
+            "INSERT INTO classification_set_factor (set_id, factor, qualified_count, ranked) "
+            "VALUES (%s, %s, %s, %s)",
+            (set_id, factor, qualified_count, ranked),
+        )
+    conn.commit()
+    return set_id
+
+
+def insert_input(
+    conn: psycopg.Connection,
+    set_id: UUID,
+    instrument_id: int,
+    factor: str,
+    input_name: str,
+    status: str,
+    *,
+    value: Any = None,
+    as_of: date | None = None,
+    known_on: date | None = None,
+) -> None:
+    """One ``factor_input`` row; a ``present`` one defaults its value and dates."""
+    if status == "present":
+        value = 1 if value is None else value
+        as_of = date(2026, 9, 30) if as_of is None else as_of
+        known_on = date(2026, 10, 1) if known_on is None else known_on
+    conn.execute(
+        "INSERT INTO factor_input (set_id, instrument_id, factor, input_name, status, value, "
+        "as_of, known_on, detail) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)",
+        (set_id, instrument_id, factor, input_name, status, value, as_of, known_on, Jsonb({})),
+    )
+    conn.commit()
+
+
+def insert_stock_inputs(
+    conn: psycopg.Connection,
+    set_id: UUID,
+    instrument_id: int,
+    statuses: dict[str, str] | None = None,
+) -> None:
+    """The stock's eight ``factor_input`` rows, ``present`` unless ``statuses`` names the input."""
+    given = statuses or {}
+    for factor in FACTORS:
+        for input_name in INPUT_NAMES[factor]:
+            insert_input(
+                conn, set_id, instrument_id, factor, input_name, given.get(input_name, "present")
+            )
