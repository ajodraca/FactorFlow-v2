+) -> None:
+    """DAC-E3-10, design 2.4: in a consistent set the stored size equals the scored roster."""
+    conn = migrated_run_schema_connection
+    set_id = _complete_set(conn, 5)
+    _stocks(conn, set_id, [{}, {}, {}, {"eps_growth": "missing"}, {}])
