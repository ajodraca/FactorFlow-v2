+    version = data.get("v")
+    if type(version) is not int or version != _CURSOR_VERSION:
+        raise CursorError(f"unsupported cursor version {version!r}; expected {_CURSOR_VERSION}")
+    if set(data) != _CURSOR_FIELDS:
