+            factor=str(r["factor"]),
+            input_name=str(r["input_name"]),
+            label=INPUT_LABELS[str(r["input_name"])],
+            status=str(r["status"]),
+            value=r["value"],
+            as_of=r["as_of"],
+            known_on=r["known_on"],
+            restated_possible=bool(r["restated_possible"]),
