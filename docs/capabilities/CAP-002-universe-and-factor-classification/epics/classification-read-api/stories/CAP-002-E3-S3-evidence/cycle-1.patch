+)
+def test_each_symbol_must_match_the_instrument_symbol_shape(symbols: list[object]) -> None:
+    """Reader design section 4 (SEC-INP-001); DEC-0132: checked as stored, never rewritten."""
+    with pytest.raises(ValueError):
