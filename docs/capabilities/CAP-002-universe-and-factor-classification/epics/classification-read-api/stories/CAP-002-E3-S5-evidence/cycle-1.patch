+T0 = datetime(2026, 10, 15, 21, 0, tzinfo=UTC)
+T1 = datetime(2026, 10, 16, 14, 30, tzinfo=UTC)
+FACTORS = ("value", "growth", "momentum")
+ZERO_FACTORS = {
+    name: {"qualified_count": 0, "ranked": False, "min_peer_set_size": 30} for name in FACTORS
+}
+SET_BLOCK_KEYS = {
+    "set_id",
+    "classification_date",
+    "run_id",
+    "run_started_at",
+    "run_outcome",
+    "state",
+    "started_at",
