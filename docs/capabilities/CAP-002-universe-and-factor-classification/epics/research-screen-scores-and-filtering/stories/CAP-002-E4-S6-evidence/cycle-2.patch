+  runStartedAt: "2026-10-15T22:30:00Z",
+  runOutcome: "succeeded",
+  state: "complete",
+  startedAt: "2026-10-15T22:40:00Z",
+  endedAt: "2026-10-15T22:46:00Z",
+  latestTradingDay: "2026-10-15",
+  activeInstruments: 2846,
+  notCurrent: false,
+};
