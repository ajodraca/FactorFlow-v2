@@ -486,6 +486,12 @@ export const SELECTION = {
   compareBlocked: "Check 2 to 6 stocks to compare them.",
   addToUniverse: "Add to universe…",
   inspectorEmpty: "Select a stock to see why it scores as it does.",
+  /**
