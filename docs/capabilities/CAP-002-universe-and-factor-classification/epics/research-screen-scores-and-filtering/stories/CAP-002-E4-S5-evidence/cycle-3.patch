++++      ...DEFAULT_RESEARCH_QUERY,
++++      sort: { key: "value_percentile", order: "desc" },
++++    });
++++    expect(result.current.navigations).toBe(1);
++++  });
++++
++++  it("clear with no sort writes the empty query", () => {
++++    const { result } = renderAt("?symbol=AA");
