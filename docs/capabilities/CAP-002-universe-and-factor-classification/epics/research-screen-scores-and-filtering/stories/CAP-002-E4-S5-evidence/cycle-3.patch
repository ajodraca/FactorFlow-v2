++++const DEFAULT_MEASURE: Measure = "percentile";
++++const DEFAULT_DIRECTION: Direction = "atLeast";
++++const MEASURES: readonly Measure[] = ["percentile", "standardisedScore"];
++++const DIRECTIONS: readonly Direction[] = ["atLeast", "atMost"];
