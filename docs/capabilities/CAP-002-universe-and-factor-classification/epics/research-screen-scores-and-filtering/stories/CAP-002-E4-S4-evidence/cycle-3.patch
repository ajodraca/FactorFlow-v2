+  setId: "B",
+  state: "building",
+  startedAt: "2026-10-16T22:40:00Z",
+  endedAt: null,
+  failureReason: null,
+  runId: "run-of-B",
+  runStartedAt: "2026-10-16T22:30:00Z",
