# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# `uv build` writes both of these; the frontend `dist/` below would cover the
# first only by coincidence, so name them here with the toolchain that creates
# them.
build/
dist/

# Frontend (created by later stories)
node_modules/
dist/
src/factorflow/api/static/*
!src/factorflow/api/static/.gitkeep

# Playwright's own run artifacts (CAP-001-E2-S4)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment
.env
.env.*
!.env.example
